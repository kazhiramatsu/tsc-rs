erminatorCount(parentNode, children[start + count - 1], format, childrenTextRange);\n    if (closingLineTerminatorCount) {\n      writeLine(closingLineTerminatorCount);\n    } else if (format & (2097152 /* SpaceAfterList */ | 256 /* SpaceBetweenBraces */)) {\n      writeSpace();\n    }\n  }",
