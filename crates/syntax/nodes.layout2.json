{
  "schema": 2,
  "why": "Compiling front-end layout preview; checker records take priority.",
  "record": {
    "headerBytes": 24,
    "handleUnitBytes": 8,
    "why": "Header fields occupy words 0..4 plus w5; this preview reserves w5 and uses the SPEC conservative 24 + 8*ceil(tail_words/2) formula. Reusing w5 for payload needs arena projection API at integration."
  },
  "tails": {},
  "binderFields": {
    "why": "Derived transitively from the snapshotted Go struct embeddings; overrides forbidden without an explanation.",
    "overrides": {}
  },
  "jsDoc": {
    "why": "No jsDoc word: HAS_JSDOC in tflags; parser owns the per-file side map.",
    "tflag": 32768
  },
  "texts": {
    "why": "TextRef tag bit31 selects source-span index or arena Bytes handle; source spans retain pos/len; arena handle must fit 31 bits.",
    "tagBit": 31
  },
  "stringTypes": {
    "JsString": {
      "why": "string literal values hold arbitrary UTF-16 (lone surrogates); numeric, raw and identifier texts stay UTF-8",
      "fields": [
        "NoSubstitutionTemplateLiteral.text",
        "StringLiteral.text",
        "TemplateHead.text",
        "TemplateMiddle.text",
        "TemplateTail.text"
      ]
    },
    "EscapedName": {
      "why": "an identifier's escaped text is the interned name the binder keys its tables by, at the size of an id",
      "fields": [
        "Identifier.escapedText",
        "PrivateIdentifier.escapedText"
      ]
    }
  },
  "rare": {
    "why": "No rare extraction without joint <1% occupancy AND >=8 B net rounded allocation saving. CallExpression pair saves 8 B but joint presence is 16951/962167 = 1.76%, so reject.",
    "kinds": {}
  },
