{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kazhiramatsu/tsc-rs/.github/ci/contracts/h2-1e-profile.schema.json",
  "title": "tsc-rs H2.1e runtime profile transition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "status",
    "phase",
    "typescript",
    "generator",
    "contract",
    "origin",
    "qualification",
    "runtime_inputs",
    "admitted_profile",
    "transition",
    "evidence",
    "summary",
    "profile_fingerprint_sha256"
  ],
  "properties": {
    "schema": { "const": 1 },
    "kind": { "const": "h2-runtime-profile" },
    "status": { "const": "qualified" },
    "phase": { "const": "H2.1e" },
    "typescript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source_commit", "bundle", "implementation"],
      "properties": {
        "version": { "const": "6.0.3" },
        "source_commit": { "$ref": "#/$defs/sha1" },
        "bundle": { "$ref": "#/$defs/path_hash" },
        "implementation": { "$ref": "#/$defs/path_hash" }
      }
    },
    "generator": { "$ref": "#/$defs/path_hash" },
    "contract": { "$ref": "#/$defs/path_hash" },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trusted_h2_1d_merge", "historical", "interpretation"],
      "properties": {
        "trusted_h2_1d_merge": { "$ref": "#/$defs/sha1" },
        "historical": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "qualification",
            "owner_controls",
            "profile_generator",
            "qualification_generator",
            "owner_controls_generator",
            "profile_contract",
            "qualification_contract",
            "owner_controls_contract"
          ],
          "properties": {
            "profile": { "$ref": "#/$defs/path_hash" },
            "qualification": { "$ref": "#/$defs/path_hash" },
            "owner_controls": { "$ref": "#/$defs/path_hash" },
            "profile_generator": { "$ref": "#/$defs/path_hash" },
            "qualification_generator": { "$ref": "#/$defs/path_hash" },
            "owner_controls_generator": { "$ref": "#/$defs/path_hash" },
            "profile_contract": { "$ref": "#/$defs/path_hash" },
            "qualification_contract": { "$ref": "#/$defs/path_hash" },
            "owner_controls_contract": { "$ref": "#/$defs/path_hash" }
          }
        },
        "interpretation": {
          "const": "H2.1d artifacts remain immutable lineage; current runtime ownership transfers to this H2.1e profile"
        }
      }
    },
    "qualification": { "$ref": "#/$defs/path_hash" },
    "runtime_inputs": {
      "type": "array",
      "minItems": 31,
      "maxItems": 31,
      "items": { "$ref": "#/$defs/path_hash" }
    },
    "admitted_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution",
        "target",
        "module_states",
        "source_kinds",
        "products",
        "exact_cases",
        "h2_1e_exact_cases",
        "exact_reported_diagnostics",
        "exact_writes",
        "diagnostic_deferred_output_controls",
        "diagnostic_control_writes",
        "source_deferred_cases",
        "candidate_denominator",
        "h2_1e_candidate_denominator"
      ],
      "properties": {
        "execution": { "const": "single-project-one-shot-whole-program" },
        "target": { "const": "ESNext(99)" },
        "module_states": {
          "const": [
            "absent-effective-ESNext",
            "ESNext(99)",
            "CommonJS(1)",
            "AMD(2)",
            "UMD(3)",
            "System(4)",
            "Node16(100)",
            "Node18(101)",
            "Node20(102)",
            "NodeNext(199)"
          ]
        },
        "source_kinds": { "const": [".ts", ".mts", ".cts"] },
        "products": { "const": ["javascript"] },
        "exact_cases": { "const": 266 },
        "h2_1e_exact_cases": { "const": 4 },
        "exact_reported_diagnostics": { "const": 518 },
        "exact_writes": { "const": 297 },
        "diagnostic_deferred_output_controls": { "const": 5 },
        "diagnostic_control_writes": { "const": 5 },
        "source_deferred_cases": { "const": 24 },
        "candidate_denominator": { "const": 295 },
        "h2_1e_candidate_denominator": { "const": 6 }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_slice",
        "next_slice",
        "active_runtime_slices",
        "inactive_runtime_slice_count",
        "node_format_owner",
        "typescript_transform_owner",
        "bundle_owner",
        "h2_1e_deferred_slices",
        "h2_1e_deferred_cases",
        "deferred_failure_boundary"
      ],
      "properties": {
        "completed_slice": { "const": "H2.1e" },
        "next_slice": { "const": "H2.2a" },
        "active_runtime_slices": { "const": ["H2.1a", "H2.1b", "H2.1c", "H2.1d", "H2.1e"] },
        "inactive_runtime_slice_count": { "const": 32 },
        "node_format_owner": { "const": "complete" },
        "typescript_transform_owner": { "const": "H2.2a" },
        "bundle_owner": { "const": "H2.7d" },
        "h2_1e_deferred_slices": { "const": ["H2.2d", "H2.9"] },
        "h2_1e_deferred_cases": { "const": 2 },
        "deferred_failure_boundary": {
          "const": "typed failure before first sink write"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "typescript_repetitions",
        "rust_repetitions",
        "legal_worker_control",
        "import_attribute_control",
        "node_format_owner_control",
        "fresh_package_and_casing_control",
        "incremental_source_fact_control",
        "deferred_format_control",
        "sink_fault_control",
        "owner_controls",
        "h0_authority",
        "h1_authority",
        "l1_authority",
        "historical_h2_1d_profile",
        "local_full_gate",
        "hosted_gate",
        "hosted_gate_scope"
      ],
      "properties": {
        "typescript_repetitions": { "const": 2 },
        "rust_repetitions": { "const": 2 },
        "legal_worker_control": {
          "const": "h2_1e_two_worker_execution_is_exact_and_isolated"
        },
        "import_attribute_control": {
          "const": "h2_1e_import_attribute_order_and_bytes_are_exact"
        },
        "node_format_owner_control": {
          "const": "h2_1e_node_format_owner_controls_match_pinned_typescript"
        },
        "fresh_package_and_casing_control": {
          "const": "h2_1e_fresh_package_type_and_path_casing_are_isolated"
        },
        "incremental_source_fact_control": {
          "const": "import_attribute_and_typescript_extension_edits_are_fresh_equivalent"
        },
        "deferred_format_control": {
          "const": "unsupported_options_and_unadmitted_extensions_fail_before_the_first_sink_call"
        },
        "sink_fault_control": {
          "const": "h2_1e_node_format_filesystem_failure_preserves_partial_set_continuation_and_activity"
        },
        "owner_controls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact", "generator", "contract"],
          "properties": {
            "artifact": { "$ref": "#/$defs/path_hash" },
            "generator": { "$ref": "#/$defs/path_hash" },
            "contract": { "$ref": "#/$defs/path_hash" }
          }
        },
        "h0_authority": { "$ref": "#/$defs/path_hash" },
        "h1_authority": { "$ref": "#/$defs/path_hash" },
        "l1_authority": { "$ref": "#/$defs/path_hash" },
        "historical_h2_1d_profile": { "$ref": "#/$defs/path_hash" },
        "local_full_gate": {
          "const": "cargo xtask ci --baseline 3cfa24fd7ef3bdd8dab97d4adf860306fac75782"
        },
        "hosted_gate": { "const": "cargo xtask acceptance" },
        "hosted_gate_scope": { "const": "fixed-unsplit-ts-tests-only" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_runtime_slices",
        "next_runtime_slices",
        "runtime_admissions",
        "executed_candidates",
        "h2_1e_executed_candidates",
        "unexecuted_candidates",
        "undispositioned_candidates",
        "historical_artifacts_reinterpreted"
      ],
      "properties": {
        "completed_runtime_slices": { "const": 5 },
        "next_runtime_slices": { "const": 1 },
        "runtime_admissions": { "const": 266 },
        "executed_candidates": { "const": 295 },
        "h2_1e_executed_candidates": { "const": 6 },
        "unexecuted_candidates": { "const": 0 },
        "undispositioned_candidates": { "const": 0 },
        "historical_artifacts_reinterpreted": { "const": 0 }
      }
    },
    "profile_fingerprint_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
