        "observation": { "$ref": "#/$defs/observation" },
        "case_fingerprint_sha256": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "role": { "const": "remove-comments-control" } },
            "required": ["role"]
          },
          "then": {
            "properties": { "remove_comments": { "const": true } }
          }
        },
        {
          "if": {
            "properties": {
              "role": { "enum": ["positive", "adjacent-negative-control"] }
            },
            "required": ["role"]
          },
          "then": {
            "properties": { "remove_comments": { "const": false } }
          }
        }
