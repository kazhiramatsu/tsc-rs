{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsc-rs.invalid/contracts/slice-readiness.v1.schema.json",
  "title": "tsc-rs Functional-CI slice readiness envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packetId",
    "status",
    "trustedBase",
    "packet",
    "predecessors",
    "allowedPaths",
    "forbiddenPrefixes",
    "proof"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packetId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "status": {
      "type": "string",
      "enum": ["design", "ready", "closed"]
    },
    "trustedBase": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^[^/].*\\.md$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "predecessors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["packetId", "receiptSha256"],
        "properties": {
          "packetId": { "type": "string" },
          "receiptSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "allowedPaths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[^/].*" }
    },
    "forbiddenPrefixes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[^/].*" }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "evidencePath"],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidencePath": { "type": "string", "pattern": "^[^/].*" }
      }
    }
  }
}
