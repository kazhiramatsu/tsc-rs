{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kazhiramatsu/tsc-rs/.github/ci/contracts/merge-receipt.schema.json",
  "title": "tsc-rs exact merge qualification receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "head_sha",
    "base_sha",
    "inputs",
    "lanes",
    "commands",
    "result_sha256",
    "authentication"
  ],
  "properties": {
    "schema": { "const": 1 },
    "kind": { "const": "exact-merge-qualification" },
    "head_sha": { "$ref": "#/$defs/sha1" },
    "base_sha": { "$ref": "#/$defs/sha1" },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rust_toolchain_sha256",
        "node_version_sha256",
        "cargo_lock_sha256",
        "vendor_inventory_sha256",
        "suite_inventory_sha256",
        "qualification_profile_sha256",
        "lane_selection_sha256"
      ],
      "properties": {
        "rust_toolchain_sha256": { "$ref": "#/$defs/sha256" },
        "node_version_sha256": { "$ref": "#/$defs/sha256" },
        "cargo_lock_sha256": { "$ref": "#/$defs/sha256" },
        "vendor_inventory_sha256": { "$ref": "#/$defs/sha256" },
        "suite_inventory_sha256": { "$ref": "#/$defs/sha256" },
        "qualification_profile_sha256": { "$ref": "#/$defs/sha256" },
        "lane_selection_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "result_sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "const": "success" },
          "result_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["argv", "exit_code", "stdout_sha256", "stderr_sha256"],
        "properties": {
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "exit_code": { "const": 0 },
          "stdout_sha256": { "$ref": "#/$defs/sha256" },
          "stderr_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "result_sha256": { "$ref": "#/$defs/sha256" },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "issuer", "subject", "attestation_sha256"],
      "properties": {
        "kind": { "enum": ["trusted-runner-oidc", "registered-signer"] },
        "issuer": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "attestation_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
