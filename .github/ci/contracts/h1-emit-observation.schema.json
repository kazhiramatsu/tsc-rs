{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kazhiramatsu/tsc-rs/.github/ci/contracts/h1-emit-observation.schema.json",
  "title": "tsc-rs H1 callback-level TypeScript emit observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "phase",
    "typescript_version",
    "source_commit",
    "profile",
    "oracle_environment",
    "comparison",
    "cases"
  ],
  "properties": {
    "schema": { "const": 1 },
    "status": { "const": "frozen" },
    "phase": { "const": "H1.0a-callback-oracle" },
    "typescript_version": { "const": "6.0.3" },
    "source_commit": { "$ref": "#/$defs/sha1" },
    "profile": { "$ref": "#/$defs/path_hash" },
    "oracle_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["virtual_root", "case_sensitive", "library"],
      "properties": {
        "virtual_root": { "const": "/project" },
        "case_sensitive": { "const": true },
        "library": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "utf8_base64", "utf8_sha256", "utf8_bytes"],
          "properties": {
            "path": { "const": "/__oracle__/lib.d.ts" },
            "utf8_base64": { "$ref": "#/$defs/base64" },
            "utf8_sha256": { "$ref": "#/$defs/sha256" },
            "utf8_bytes": { "$ref": "#/$defs/nonnegative_integer" }
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_bytes", "text_normalization", "path_mapping", "repeated_runs"],
      "properties": {
        "output_bytes": { "const": "exact" },
        "text_normalization": { "const": "none" },
        "path_mapping": { "type": "string", "minLength": 1 },
        "repeated_runs": { "const": 2 }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "base64": { "type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" },
    "nonnegative_integer": { "type": "integer", "minimum": 0 },
    "path_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "presence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "value"],
      "properties": {
        "present": { "type": "boolean" },
        "value": {}
      }
    },
    "message_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "code", "category", "next_present", "next"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "code": { "$ref": "#/$defs/nonnegative_integer" },
        "category": { "enum": ["warning", "error", "suggestion", "message"] },
        "next_present": { "type": "boolean" },
        "next": { "type": "array", "items": { "$ref": "#/$defs/message_chain" } }
      }
    },
    "related_diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "start", "length", "code", "category", "chain"],
      "properties": {
        "file": { "$ref": "#/$defs/presence" },
        "start": { "$ref": "#/$defs/presence" },
        "length": { "$ref": "#/$defs/presence" },
        "code": { "$ref": "#/$defs/nonnegative_integer" },
        "category": { "enum": ["warning", "error", "suggestion", "message"] },
        "chain": { "$ref": "#/$defs/message_chain" }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "start",
        "length",
        "line",
        "column",
        "code",
        "category",
        "chain",
        "related_information_present",
        "related",
        "reports_unnecessary",
        "reports_deprecated",
        "source"
      ],
      "properties": {
        "file": { "$ref": "#/$defs/presence" },
        "start": { "$ref": "#/$defs/presence" },
        "length": { "$ref": "#/$defs/presence" },
        "line": { "$ref": "#/$defs/presence" },
        "column": { "$ref": "#/$defs/presence" },
        "code": { "$ref": "#/$defs/nonnegative_integer" },
        "category": { "enum": ["warning", "error", "suggestion", "message"] },
        "chain": { "$ref": "#/$defs/message_chain" },
        "related_information_present": { "type": "boolean" },
        "related": { "type": "array", "items": { "$ref": "#/$defs/related_diagnostic" } },
        "reports_unnecessary": { "$ref": "#/$defs/presence" },
        "reports_deprecated": { "$ref": "#/$defs/presence" },
        "source": { "$ref": "#/$defs/presence" }
      }
    },
    "metadata_value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "own_keys",
        "source_map_url_position_utf16",
        "diagnostics_present",
        "diagnostics",
        "skipped_dts_write",
        "differs_only_in_map",
        "build_info"
      ],
      "properties": {
        "own_keys": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "source_map_url_position_utf16": { "$ref": "#/$defs/presence" },
        "diagnostics_present": { "type": "boolean" },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
        "skipped_dts_write": { "$ref": "#/$defs/presence" },
        "differs_only_in_map": { "$ref": "#/$defs/presence" },
        "build_info": { "$ref": "#/$defs/presence" }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "value"],
      "properties": {
        "present": { "type": "boolean" },
        "value": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/metadata_value" }] }
      }
    },
    "write": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "path",
        "kind",
        "callback_text",
        "callback_utf8_base64",
        "callback_utf8_sha256",
        "callback_utf8_bytes",
        "write_byte_order_mark",
        "materialized_utf8_base64",
        "materialized_utf8_sha256",
        "materialized_utf8_bytes",
        "on_error_callback_present",
        "source_files_present",
        "source_files",
        "metadata",
        "sink_disposition"
      ],
      "properties": {
        "index": { "$ref": "#/$defs/nonnegative_integer" },
        "path": { "type": "string", "pattern": "^/project/" },
        "kind": { "enum": ["javascript", "source-map", "declaration", "build-info"] },
        "callback_text": { "type": "string" },
        "callback_utf8_base64": { "$ref": "#/$defs/base64" },
        "callback_utf8_sha256": { "$ref": "#/$defs/sha256" },
        "callback_utf8_bytes": { "$ref": "#/$defs/nonnegative_integer" },
        "write_byte_order_mark": { "type": "boolean" },
        "materialized_utf8_base64": { "$ref": "#/$defs/base64" },
        "materialized_utf8_sha256": { "$ref": "#/$defs/sha256" },
        "materialized_utf8_bytes": { "$ref": "#/$defs/nonnegative_integer" },
        "on_error_callback_present": { "type": "boolean" },
        "source_files_present": { "type": "boolean" },
        "source_files": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "metadata": { "$ref": "#/$defs/metadata" },
        "sink_disposition": { "const": "written" }
      }
    },
    "source_map_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_source_file_names", "source_map"],
      "properties": {
        "input_source_file_names": { "type": "array", "items": { "type": "string" } },
        "source_map": { "type": "object" }
      }
    },
    "input_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "utf8_base64", "utf8_sha256", "utf8_bytes"],
      "properties": {
        "path": { "type": "string", "pattern": "^/project/" },
        "utf8_base64": { "$ref": "#/$defs/base64" },
        "utf8_sha256": { "$ref": "#/$defs/sha256" },
        "utf8_bytes": { "$ref": "#/$defs/nonnegative_integer" }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "determinism", "observation"],
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "classification", "compiler_options", "root_files"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "classification": { "enum": ["admitted", "adjacent-unsupported"] },
            "compiler_options": { "type": "object" },
            "root_files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/input_file" } }
          }
        },
        "determinism": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repeat_runs", "exact_match"],
          "properties": {
            "repeat_runs": { "const": 2 },
            "exact_match": { "const": true }
          }
        },
        "observation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile_gate",
            "rust_expectation",
            "writes",
            "reported_diagnostics",
            "emit_result",
            "status_writes",
            "process_exit"
          ],
          "properties": {
            "profile_gate": {
              "type": "object",
              "additionalProperties": false,
              "required": ["disposition", "reasons"],
              "properties": {
                "disposition": { "enum": ["admitted", "h0-no-emit", "unsupported-before-first-write"] },
                "reasons": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
              }
            },
            "rust_expectation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["outcome", "sink_write_count"],
              "properties": {
                "outcome": { "enum": ["exact-typescript-observation", "existing-h0-route", "typed-unsupported-before-first-write"] },
                "sink_write_count": { "$ref": "#/$defs/nonnegative_integer" }
              }
            },
            "writes": { "type": "array", "items": { "$ref": "#/$defs/write" } },
            "reported_diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
            "emit_result": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "emit_skipped",
                "emit_diagnostics",
                "emitted_files_present",
                "emitted_files",
                "source_maps_present",
                "source_maps"
              ],
              "properties": {
                "emit_skipped": { "type": "boolean" },
                "emit_diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
                "emitted_files_present": { "type": "boolean" },
                "emitted_files": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "source_maps_present": { "type": "boolean" },
                "source_maps": { "type": "array", "items": { "$ref": "#/$defs/source_map_observation" } }
              }
            },
            "status_writes": { "type": "array", "items": { "type": "string" } },
            "process_exit": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "name"],
              "properties": {
                "code": { "type": "integer", "minimum": 0, "maximum": 2 },
                "name": { "enum": ["success", "diagnostics-present-outputs-skipped", "diagnostics-present-outputs-generated"] }
              }
            }
          }
        }
      }
    }
  }
}
