        "flags": { "type": "integer" },
        "prefix": { "type": ["string", "null"] },
        "suffix": { "type": ["string", "null"] },
        "source": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/node_selector" }
          ]
        }
      }
    },
    "factory_tree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text",
        "transform_flags",
        "emit_flags",
        "generated",
        "children"
      ],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "text": { "type": ["string", "null"] },
        "transform_flags": { "type": "integer" },
        "emit_flags": { "type": "integer" },
        "generated": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/generated_identity" }
          ]
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/factory_tree_depth2" }
        }
      }
    },
    "factory_tree_depth2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text",
        "transform_flags",
        "emit_flags",
        "generated",
        "children"
      ],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "text": { "type": ["string", "null"] },
        "transform_flags": { "type": "integer" },
        "emit_flags": { "type": "integer" },
        "generated": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/generated_identity" }
          ]
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/factory_tree_depth3" }
        }
      }
    },
    "factory_tree_depth3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text",
        "transform_flags",
        "emit_flags",
        "generated",
        "children"
      ],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "text": { "type": ["string", "null"] },
        "transform_flags": { "type": "integer" },
        "emit_flags": { "type": "integer" },
        "generated": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/generated_identity" }
          ]
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/factory_tree_depth4" }
        }
      }
    },
    "factory_tree_depth4": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text",
        "transform_flags",
        "emit_flags",
        "generated",
        "children"
      ],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "text": { "type": ["string", "null"] },
        "transform_flags": { "type": "integer" },
        "emit_flags": { "type": "integer" },
        "generated": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/generated_identity" }
          ]
        },
        "children": { "const": [] }
      }
    },
    "factory_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "tree"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "tree": { "$ref": "#/$defs/factory_tree" }
      }
    },
    "factory_relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "left_label", "right_label", "result"],
      "properties": {
        "relation": { "type": "string", "minLength": 1 },
        "left_label": { "type": "string", "minLength": 1 },
        "right_label": { "type": "string", "minLength": 1 },
        "result": { "type": "boolean" }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "code", "category", "file", "start", "length"],
      "properties": {
        "phase": { "enum": ["pre-emit", "emit"] },
        "code": { "type": "integer", "minimum": 0 },
        "category": {
          "enum": ["Warning", "Error", "Suggestion", "Message"]
        },
        "file": { "type": ["string", "null"] },
        "start": { "type": ["integer", "null"], "minimum": 0 },
        "length": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "write": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "path",
        "callback_utf8_base64",
        "callback_utf8_sha256",
        "callback_utf8_bytes",
        "write_byte_order_mark",
        "materialized_utf8_sha256",
        "materialized_utf8_bytes",
        "on_error_callback_present",
        "source_files"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "path": { "type": "string", "minLength": 1 },
        "callback_utf8_base64": { "type": "string" },
        "callback_utf8_sha256": { "$ref": "#/$defs/sha256" },
        "callback_utf8_bytes": { "type": "integer", "minimum": 0 },
        "write_byte_order_mark": { "type": "boolean" },
        "materialized_utf8_sha256": { "$ref": "#/$defs/sha256" },
        "materialized_utf8_bytes": { "type": "integer", "minimum": 0 },
        "on_error_callback_present": { "type": "boolean" },
        "source_files": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "syntax_nodes",
        "checker_bindings",
        "resolver_queries",
        "factory_nodes",
        "factory_relations",
        "reported_diagnostics",
        "emit_diagnostics",
        "emit_skipped",
        "writes",
        "observation_fingerprint_sha256"
      ],
      "properties": {
        "syntax_nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/syntax_fact" }
        },
        "checker_bindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/checker_binding" }
        },
        "resolver_queries": {
          "type": "array",
          "items": { "$ref": "#/$defs/resolver_query" }
        },
        "factory_nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/factory_node" }
        },
        "factory_relations": {
          "type": "array",
          "items": { "$ref": "#/$defs/factory_relation" }
        },
        "reported_diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" }
        },
        "emit_diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" }
        },
        "emit_skipped": { "const": false },
        "writes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/write" }
        },
        "observation_fingerprint_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "input_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "root",
        "utf8_base64",
        "utf8_sha256",
        "utf8_bytes"
      ],
      "properties": {
        "path": { "const": "/project/input.ts" },
        "root": { "const": true },
        "utf8_base64": { "type": "string", "minLength": 1 },
        "utf8_sha256": { "$ref": "#/$defs/sha256" },
        "utf8_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "control_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_directory", "roots", "files", "compiler_options"],
      "properties": {
        "current_directory": { "const": "/project" },
        "roots": { "const": ["/project/input.ts"] },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/input_file" }
        },
        "compiler_options": {
          "const": {
            "alwaysStrict": true,
            "downlevelIteration": true,
            "ignoreDeprecations": "6.0",
            "importHelpers": false,
            "module": 99,
            "newLine": 1,
            "noEmitHelpers": false,
            "target": 1,
            "useDefineForClassFields": false,
            "useUnknownInCatchVariables": false
          }
        }
      }
    },
    "direct_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_id",
        "layers",
        "input",
        "repetitions",
        "observation",
        "control_fingerprint_sha256"
      ],
      "properties": {
        "control_id": { "type": "string", "minLength": 1 },
        "layers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["syntax", "checker", "resolver", "factory"] }
        },
        "input": { "$ref": "#/$defs/control_input" },
        "repetitions": { "const": 2 },
        "observation": { "$ref": "#/$defs/observation" },
        "control_fingerprint_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "git_blob_sha1"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "git_blob_sha1": { "$ref": "#/$defs/sha1" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "suite",
        "upstream_case",
        "id",
        "source",
        "required_slices",
        "foundation_route",
        "execution_state",
        "runtime_admission",
        "candidate_fingerprint_sha256"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 931 },
        "suite": { "enum": ["compiler", "conformance", "project"] },
        "upstream_case": { "type": "integer", "minimum": 0 },
        "id": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/source_identity" },
        "required_slices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "H2.1a",
              "H2.1b",
              "H2.1c",
              "H2.1d",
              "H2.1e",
              "H2.2a",
              "H2.2b",
              "H2.2c",
              "H2.2d",
              "H2.3a",
              "H2.3b",
              "H2.3c",
              "H2.3d",
              "H2.4a",
              "H2.4b",
              "H2.5a",
              "H2.5b",
              "H2.5c",
              "H2.5d",
              "H2.5e",
              "H2.5f",
              "H2.5g",
              "H2.5h"
            ]
          }
        },
        "foundation_route": {
          "enum": ["runner-executable", "project-foundation-only"]
        },
        "execution_state": { "const": "not-run" },
        "runtime_admission": { "const": false },
        "candidate_fingerprint_sha256": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "suite": { "const": "project" } },
            "required": ["suite"]
          },
          "then": {
            "properties": {
              "foundation_route": { "const": "project-foundation-only" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "suite": { "enum": ["compiler", "conformance"] }
            },
            "required": ["suite"]
          },
          "then": {
            "properties": {
              "foundation_route": { "const": "runner-executable" }
            }
          }
        }
      ]
    }
  }
}
