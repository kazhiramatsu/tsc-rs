{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kazhiramatsu/tsc-rs/.github/ci/contracts/h2-3b-profile.schema.json",
  "title": "tsc-rs H2.3b runtime profile transition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "status",
    "phase",
    "typescript",
    "generator",
    "contract",
    "origin",
    "qualification",
    "runtime_inputs",
    "admitted_profile",
    "transition",
    "evidence",
    "summary",
    "profile_fingerprint_sha256"
  ],
  "properties": {
    "schema": { "const": 1 },
    "kind": { "const": "h2-runtime-profile" },
    "status": { "const": "qualified" },
    "phase": { "const": "H2.3b" },
    "typescript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source_commit", "bundle", "implementation"],
      "properties": {
        "version": { "const": "6.0.3" },
        "source_commit": { "$ref": "#/$defs/sha1" },
        "bundle": { "$ref": "#/$defs/path_hash" },
        "implementation": { "$ref": "#/$defs/path_hash" }
      }
    },
    "generator": { "$ref": "#/$defs/path_hash" },
    "contract": { "$ref": "#/$defs/path_hash" },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trusted_h2_3a_merge", "historical", "interpretation"],
      "properties": {
        "trusted_h2_3a_merge": { "$ref": "#/$defs/sha1" },
        "historical": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "qualification",
            "owner_controls",
            "profile_generator",
            "qualification_generator",
            "owner_controls_generator",
            "profile_contract",
            "qualification_contract",
            "owner_controls_contract"
          ],
          "properties": {
            "profile": { "$ref": "#/$defs/path_hash" },
            "qualification": { "$ref": "#/$defs/path_hash" },
            "owner_controls": { "$ref": "#/$defs/path_hash" },
            "profile_generator": { "$ref": "#/$defs/path_hash" },
            "qualification_generator": { "$ref": "#/$defs/path_hash" },
            "owner_controls_generator": { "$ref": "#/$defs/path_hash" },
            "profile_contract": { "$ref": "#/$defs/path_hash" },
            "qualification_contract": { "$ref": "#/$defs/path_hash" },
            "owner_controls_contract": { "$ref": "#/$defs/path_hash" }
          }
        },
        "interpretation": {
          "const": "H2.3a artifacts remain immutable lineage; current runtime ownership transfers to this H2.3b profile"
        }
      }
    },
    "qualification": { "$ref": "#/$defs/path_hash" },
    "runtime_inputs": {
      "type": "array",
      "minItems": 58,
      "maxItems": 58,
      "items": { "$ref": "#/$defs/path_hash" }
    },
    "admitted_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution",
        "target",
        "module_states",
        "jsx_modes",
        "source_kinds",
        "products",
        "exact_cases",
        "h2_3b_exact_cases",
        "exact_reported_diagnostics",
        "exact_writes",
        "diagnostic_deferred_output_controls",
        "diagnostic_control_writes",
        "source_deferred_cases",
        "candidate_denominator",
        "h2_3b_candidate_denominator"
      ],
      "properties": {
        "execution": { "const": "single-project-one-shot-whole-program" },
        "target": { "const": "ESNext(99)" },
        "module_states": {
          "const": [
            "absent-effective-ESNext",
            "ESNext(99)",
            "CommonJS(1)",
            "AMD(2)",
            "UMD(3)",
            "System(4)",
            "Node16(100)",
            "Node18(101)",
            "Node20(102)",
            "NodeNext(199)"
          ]
        },
        "jsx_modes": { "const": ["Preserve(1)", "React(2)", "ReactNative(3)"] },
        "source_kinds": {
          "const": [".ts", ".mts", ".cts", ".tsx", ".js", ".mjs", ".cjs", ".jsx"]
        },
        "products": { "const": ["javascript", "mjs", "cjs", "jsx"] },
        "exact_cases": { "const": 305 },
        "h2_3b_exact_cases": { "const": 2 },
        "exact_reported_diagnostics": { "const": 638 },
        "exact_writes": { "const": 400 },
        "diagnostic_deferred_output_controls": { "const": 5 },
        "diagnostic_control_writes": { "const": 5 },
        "source_deferred_cases": { "const": 4 },
        "candidate_denominator": { "const": 302 },
        "h2_3b_candidate_denominator": { "const": 6 }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_slice",
        "next_slice",
        "active_runtime_slices",
        "inactive_runtime_slice_count",
        "classic_jsx_tsx_owner",
        "automatic_jsx_runtime_owner",
        "json_output_owner",
        "general_output_matrix_owner",
        "h2_3b_deferred_slices",
        "h2_3b_deferred_cases",
        "inherited_h2_3a_residual_slices",
        "inherited_h2_3a_residual_cases",
        "deferred_failure_boundary"
      ],
      "properties": {
        "completed_slice": { "const": "H2.3b" },
        "next_slice": { "const": "H2.3c" },
        "active_runtime_slices": {
          "const": [
            "H2.1a",
            "H2.1b",
            "H2.1c",
            "H2.1d",
            "H2.1e",
            "H2.2a",
            "H2.2b",
            "H2.2c",
            "H2.2d",
            "H2.3a",
            "H2.3b"
          ]
        },
        "inactive_runtime_slice_count": { "const": 26 },
        "classic_jsx_tsx_owner": { "const": "complete" },
        "automatic_jsx_runtime_owner": { "const": "H2.3c" },
        "json_output_owner": { "const": "H2.3d" },
        "general_output_matrix_owner": { "const": "H2.8a" },
        "h2_3b_deferred_slices": { "const": ["H2.3c"] },
        "h2_3b_deferred_cases": { "const": 4 },
        "inherited_h2_3a_residual_slices": { "const": [] },
        "inherited_h2_3a_residual_cases": { "const": 0 },
        "deferred_failure_boundary": {
          "const": "typed failure before first sink write"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "typescript_repetitions",
        "rust_repetitions",
        "legal_worker_control",
        "denominator_control",
        "classic_transform_control",
        "commonjs_factory_control",
        "preserve_native_control",
        "owner_matrix_control",
        "owner_controls",
        "h0_authority",
        "h1_authority",
        "l1_authority",
        "historical_h2_3a_profile",
        "local_full_gate",
        "hosted_gate",
        "hosted_gate_scope"
      ],
      "properties": {
        "typescript_repetitions": { "const": 2 },
        "rust_repetitions": { "const": 2 },
        "legal_worker_control": {
          "const": "h2_3b_two_worker_execution_is_exact_and_isolated"
        },
        "denominator_control": {
          "const": "h2_3b_denominator_separates_classic_from_automatic_runtime"
        },
        "classic_transform_control": {
          "const": "h2_3b_classic_jsx_factories_fragments_namespaces_and_ranges_match_typescript"
        },
        "commonjs_factory_control": {
          "const": "h2_3b_classic_factory_import_substitution_and_lexical_shadowing_match_typescript"
        },
        "preserve_native_control": {
          "const": "h2_3b_preserve_and_react_native_reconstruct_jsx_with_exact_extensions"
        },
        "owner_matrix_control": {
          "const": "h2_3b_owner_controls_cover_modes_factories_pragmas_and_extensions"
        },
        "owner_controls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact", "generator", "contract"],
          "properties": {
            "artifact": { "$ref": "#/$defs/path_hash" },
            "generator": { "$ref": "#/$defs/path_hash" },
            "contract": { "$ref": "#/$defs/path_hash" }
          }
        },
        "h0_authority": { "$ref": "#/$defs/path_hash" },
        "h1_authority": { "$ref": "#/$defs/path_hash" },
        "l1_authority": { "$ref": "#/$defs/path_hash" },
        "historical_h2_3a_profile": { "$ref": "#/$defs/path_hash" },
        "local_full_gate": {
          "const": "cargo xtask ci --baseline 3ce56e1fdb1c3841bc27f37b33488d3dd25b65a0"
        },
        "hosted_gate": { "const": "cargo xtask acceptance" },
        "hosted_gate_scope": { "const": "fixed-unsplit-ts-tests-only" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_runtime_slices",
        "next_runtime_slices",
        "runtime_admissions",
        "executed_candidates",
        "h2_3b_executed_candidates",
        "unexecuted_candidates",
        "undispositioned_candidates",
        "historical_artifacts_reinterpreted"
      ],
      "properties": {
        "completed_runtime_slices": { "const": 11 },
        "next_runtime_slices": { "const": 1 },
        "runtime_admissions": { "const": 305 },
        "executed_candidates": { "const": 302 },
        "h2_3b_executed_candidates": { "const": 6 },
        "unexecuted_candidates": { "const": 0 },
        "undispositioned_candidates": { "const": 0 },
        "historical_artifacts_reinterpreted": { "const": 0 }
      }
    },
    "profile_fingerprint_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
