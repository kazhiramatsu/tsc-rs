{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kazhiramatsu/tsc-rs/.github/ci/contracts/h1-conformance-expansion.schema.json",
  "title": "tsc-rs H1 conformance CompilerBaselineRunner expansion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "phase",
    "typescript",
    "producer_sources",
    "independent_oracle",
    "contract",
    "inputs",
    "runner_contract",
    "source_inventory_sha256",
    "sources",
    "not_enumerated_sources",
    "fixtures",
    "cases",
    "summary"
  ],
  "properties": {
    "schema": { "const": 1 },
    "status": { "const": "expanded-not-run" },
    "phase": { "const": "H1.0a-conformance-runner-expansion" },
    "typescript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source_repository", "source_commit"],
      "properties": {
        "version": { "const": "6.0.3" },
        "source_repository": { "const": "https://github.com/microsoft/TypeScript.git" },
        "source_commit": { "$ref": "#/$defs/sha1" }
      }
    },
    "producer_sources": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/path_hash" }
    },
    "independent_oracle": { "$ref": "#/$defs/path_hash" },
    "contract": { "$ref": "#/$defs/path_hash" },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite_pin",
        "conformance_suite",
        "typescript_bundle",
        "implementation_sources"
      ],
      "properties": {
        "suite_pin": { "$ref": "#/$defs/path_hash" },
        "conformance_suite": { "$ref": "#/$defs/suite_identity" },
        "typescript_bundle": { "$ref": "#/$defs/path_hash" },
        "implementation_sources": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/git_source" }
        }
      }
    },
    "runner_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enumeration",
        "emit_enabled",
        "vary_by",
        "variation_limit",
        "configuration_order",
        "unit_partition",
        "observations",
        "reference_baseline_state"
      ],
      "properties": {
        "enumeration": { "const": "recursive files matching /\\.tsx?$/ in tests/cases/conformance" },
        "emit_enabled": { "const": true },
        "vary_by": {
          "type": "array",
          "minItems": 77,
          "maxItems": 77,
          "items": { "type": "string", "minLength": 1 }
        },
        "variation_limit": { "const": 25 },
        "configuration_order": { "type": "string", "minLength": 1 },
        "unit_partition": { "type": "string", "minLength": 1 },
        "observations": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/runner_observation" }
        },
        "reference_baseline_state": { "$ref": "#/$defs/reference_baseline_state" }
      }
    },
    "source_inventory_sha256": { "$ref": "#/$defs/sha256" },
    "sources": {
      "type": "array",
      "minItems": 5908,
      "maxItems": 5908,
      "items": { "$ref": "#/$defs/source" }
    },
    "not_enumerated_sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "reason"],
        "properties": {
          "source": { "type": "integer", "minimum": 0, "maximum": 5907 },
          "reason": { "const": "extension-does-not-match-/\\.tsx?$/" }
        }
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 5907,
      "maxItems": 5907,
      "items": { "$ref": "#/$defs/fixture" }
    },
    "cases": {
      "type": "array",
      "minItems": 7697,
      "maxItems": 7697,
      "items": { "$ref": "#/$defs/case" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "git_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "git_blob_sha1"],
      "properties": {
        "source_path": { "type": "string", "minLength": 1 },
        "git_blob_sha1": { "$ref": "#/$defs/sha1" }
      }
    },
    "suite_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source_path",
        "vendored_path",
        "git_tree_sha1",
        "blob_inventory_sha256",
        "files",
        "bytes",
        "unique_blobs",
        "executable_paths"
      ],
      "properties": {
        "name": { "const": "conformance" },
        "source_path": { "const": "tests/cases/conformance" },
        "vendored_path": { "const": "ts-tests/tests/cases/conformance" },
        "git_tree_sha1": { "$ref": "#/$defs/sha1" },
        "blob_inventory_sha256": { "$ref": "#/$defs/sha256" },
        "files": { "const": 5908 },
        "bytes": { "const": 3825804 },
        "unique_blobs": { "const": 5862 },
        "executable_paths": { "type": "array", "maxItems": 0 }
      }
    },
    "reference_baseline_state": { "const": "content-not-vendored-or-compared" },
    "execution_state": { "const": "not-run" },
    "runner_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "upstream_method",
        "invocation_gate",
        "initial_execution_state",
        "reference_baseline_state"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "upstream_method": { "type": "string", "minLength": 1 },
        "invocation_gate": { "type": "string", "minLength": 1 },
        "initial_execution_state": { "$ref": "#/$defs/execution_state" },
        "reference_baseline_state": { "$ref": "#/$defs/reference_baseline_state" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode", "bytes", "sha256", "git_blob_sha1"],
      "properties": {
        "path": { "type": "string", "pattern": "^[^/]" },
        "mode": { "const": "100644" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "git_blob_sha1": { "$ref": "#/$defs/sha1" }
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "string" }
      }
    },
    "content": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "utf8_bytes", "sha256"],
          "properties": {
            "state": { "const": "present" },
            "utf8_bytes": { "type": "integer", "minimum": 0 },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": { "state": { "const": "missing" } }
        }
      ]
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "file_options", "content", "document_symlinks"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "file_options": { "type": "array", "items": { "$ref": "#/$defs/setting" } },
        "content": { "$ref": "#/$defs/content" },
        "document_symlinks": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "link_path"],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "link_path": { "type": "string", "minLength": 1 }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variant", "description", "upstream_name", "settings"],
      "properties": {
        "variant": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "upstream_name": { "type": "string", "minLength": 1 },
        "settings": { "type": "array", "items": { "$ref": "#/$defs/setting" } }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "encoding",
        "decoded_utf8_bytes",
        "decoded_sha256",
        "settings",
        "normal_units",
        "virtual_config",
        "links",
        "configurations"
      ],
      "properties": {
        "source": { "type": "integer", "minimum": 0, "maximum": 5907 },
        "encoding": { "enum": ["utf-8", "utf-8-bom", "utf-16le", "utf-16be"] },
        "decoded_utf8_bytes": { "type": "integer", "minimum": 0 },
        "decoded_sha256": { "$ref": "#/$defs/sha256" },
        "settings": { "type": "array", "items": { "$ref": "#/$defs/setting" } },
        "normal_units": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/unit" } },
        "virtual_config": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/unit" }]
        },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "configurations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 25,
          "items": { "$ref": "#/$defs/configuration" }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "configuration",
        "observations",
        "initial_execution_state",
        "reference_baseline_state"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^typescript-6\\.0\\.3/conformance/" },
        "source": { "type": "integer", "minimum": 0, "maximum": 5907 },
        "configuration": { "type": "integer", "minimum": 0, "maximum": 24 },
        "observations": {
          "type": "array",
          "prefixItems": [
            { "const": 0 },
            { "const": 1 },
            { "const": 2 },
            { "const": 3 },
            { "const": 4 },
            { "const": 5 }
          ],
          "items": false,
          "minItems": 6,
          "maxItems": 6
        },
        "initial_execution_state": { "$ref": "#/$defs/execution_state" },
        "reference_baseline_state": { "$ref": "#/$defs/reference_baseline_state" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_files",
        "source_bytes",
        "unique_blobs",
        "enumerated_fixtures",
        "not_enumerated_sources",
        "default_fixtures",
        "matrix_fixtures",
        "cases",
        "normal_units",
        "virtual_configs",
        "present_empty_units",
        "missing_content_units",
        "link_directives",
        "document_symlink_directives",
        "document_symlink_paths",
        "runner_observations",
        "case_observations",
        "not_run_cases",
        "not_run_case_observations",
        "execution_results_recorded",
        "reference_baselines_compared"
      ],
      "properties": {
        "source_files": { "const": 5908 },
        "source_bytes": { "const": 3825804 },
        "unique_blobs": { "const": 5862 },
        "enumerated_fixtures": { "const": 5907 },
        "not_enumerated_sources": { "const": 1 },
        "default_fixtures": { "const": 4809 },
        "matrix_fixtures": { "const": 1098 },
        "cases": { "const": 7697 },
        "normal_units": { "const": 8055 },
        "virtual_configs": { "const": 27 },
        "present_empty_units": { "const": 14 },
        "missing_content_units": { "const": 0 },
        "link_directives": { "const": 0 },
        "document_symlink_directives": { "const": 0 },
        "document_symlink_paths": { "const": 0 },
        "runner_observations": { "const": 6 },
        "case_observations": { "const": 46182 },
        "not_run_cases": { "const": 7697 },
        "not_run_case_observations": { "const": 46182 },
        "execution_results_recorded": { "const": 0 },
        "reference_baselines_compared": { "const": 0 }
      }
    }
  }
}
