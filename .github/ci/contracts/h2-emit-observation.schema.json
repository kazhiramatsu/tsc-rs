{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kazhiramatsu/tsc-rs/.github/ci/contracts/h2-emit-observation.schema.json",
  "title": "tsc-rs H2 exact one-shot compiler observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "phase",
    "status",
    "typescript",
    "candidate_dispositions",
    "source_reachability",
    "suite",
    "case_id",
    "slice",
    "runner",
    "input_fingerprint_sha256",
    "typescript_runs",
    "rust_runs",
    "comparison"
  ],
  "properties": {
    "schema": { "const": 1 },
    "phase": { "const": "H2-exact-emit-observation" },
    "status": { "enum": ["candidate", "frozen"] },
    "typescript": { "$ref": "#/$defs/typescript" },
    "candidate_dispositions": { "$ref": "#/$defs/path_hash" },
    "source_reachability": { "$ref": "#/$defs/path_hash" },
    "suite": { "enum": ["compiler", "conformance", "project", "transpile"] },
    "case_id": { "type": "string", "minLength": 1 },
    "slice": { "type": "string", "pattern": "^H2\\.[0-9]+[a-z]?$" },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity", "environment"],
      "properties": {
        "kind": { "enum": ["compiler", "conformance", "project", "transpile"] },
        "identity": { "$ref": "#/$defs/path_hash" },
        "environment": { "type": "object" }
      }
    },
    "input_fingerprint_sha256": { "$ref": "#/$defs/sha256" },
    "typescript_runs": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/run" }
    },
    "rust_runs": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/run" }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["typescript_deterministic", "rust_deterministic", "exact_match", "normalization", "mismatches"],
      "properties": {
        "typescript_deterministic": { "const": true },
        "rust_deterministic": { "const": true },
        "exact_match": { "type": "boolean" },
        "normalization": { "const": "none" },
        "mismatches": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "base64": { "type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" },
    "path_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "typescript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source_commit", "bundle"],
      "properties": {
        "version": { "const": "6.0.3" },
        "source_commit": { "$ref": "#/$defs/sha1" },
        "bundle": { "$ref": "#/$defs/path_hash" }
      }
    },
    "observable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "present", "encoding", "payload_base64", "sha256", "bytes"],
      "properties": {
        "name": {
          "enum": [
            "reported-diagnostics",
            "emit-result",
            "write-callbacks",
            "materialized-outputs",
            "source-maps",
            "stdout",
            "stderr",
            "exit",
            "filesystem-trace",
            "resolver-trace",
            "transform-trace",
            "resource-summary"
          ]
        },
        "present": { "type": "boolean" },
        "encoding": { "enum": ["canonical-json", "utf8", "binary"] },
        "payload_base64": { "$ref": "#/$defs/base64" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "observables", "run_fingerprint_sha256"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "observables": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/observable" }
        },
        "run_fingerprint_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
