{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kazhiramatsu/tsc-rs/.github/ci/contracts/h1-printer-foundation.schema.json",
  "title": "tsc-rs H1.2 writer, position, and printer foundation oracle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "phase",
    "typescript",
    "generator",
    "contract",
    "authorities",
    "summary",
    "writer_cases",
    "source_position_cases",
    "printer_cases",
    "oracle_fingerprint_sha256"
  ],
  "properties": {
    "schema": { "const": 1 },
    "status": { "const": "frozen-h1.2-printer-foundation" },
    "phase": { "const": "H1.2" },
    "typescript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source_commit"],
      "properties": {
        "version": { "const": "6.0.3" },
        "source_commit": { "$ref": "#/$defs/sha1" }
      }
    },
    "generator": { "$ref": "#/$defs/path_hash" },
    "contract": { "$ref": "#/$defs/path_hash" },
    "authorities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design", "typescript", "tsc"],
      "properties": {
        "design": { "$ref": "#/$defs/path_hash" },
        "typescript": { "$ref": "#/$defs/path_hash" },
        "tsc": { "$ref": "#/$defs/path_hash" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writer_cases",
        "writer_steps",
        "source_position_cases",
        "source_positions",
        "printer_cases",
        "printer_tokens"
      ],
      "properties": {
        "writer_cases": { "const": 2 },
        "writer_steps": { "const": 20 },
        "source_position_cases": { "const": 3 },
        "source_positions": { "const": 28 },
        "printer_cases": { "const": 2 },
        "printer_tokens": { "$ref": "#/$defs/positive_integer" }
      }
    },
    "writer_cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/writer_case" }
    },
    "source_position_cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/source_case" }
    },
    "printer_cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/printer_case" }
    },
    "oracle_fingerprint_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nonnegative_integer": { "type": "integer", "minimum": 0 },
    "positive_integer": { "type": "integer", "minimum": 1 },
    "path_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "writer_operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {
            "kind": {
              "enum": [
                "write",
                "rawWrite",
                "writeLiteral",
                "writeKeyword",
                "writeComment",
                "writeSpace"
              ]
            },
            "text": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "force"],
          "properties": {
            "kind": { "const": "writeLine" },
            "force": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "enum": ["increaseIndent", "decreaseIndent", "clear"]
            }
          }
        }
      ]
    },
    "writer_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "text_utf8_bytes",
        "text_utf8_sha256",
        "text_position_utf16",
        "line",
        "column_utf16",
        "indent",
        "at_start_of_line",
        "has_trailing_comment",
        "has_trailing_whitespace"
      ],
      "properties": {
        "text": { "type": "string" },
        "text_utf8_bytes": { "$ref": "#/$defs/nonnegative_integer" },
        "text_utf8_sha256": { "$ref": "#/$defs/sha256" },
        "text_position_utf16": { "$ref": "#/$defs/nonnegative_integer" },
        "line": { "$ref": "#/$defs/nonnegative_integer" },
        "column_utf16": { "$ref": "#/$defs/nonnegative_integer" },
        "indent": { "$ref": "#/$defs/nonnegative_integer" },
        "at_start_of_line": { "type": "boolean" },
        "has_trailing_comment": { "type": "boolean" },
        "has_trailing_whitespace": { "type": "boolean" }
      }
    },
    "writer_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "operation", "state"],
      "properties": {
        "index": { "$ref": "#/$defs/nonnegative_integer" },
        "operation": { "$ref": "#/$defs/writer_operation" },
        "state": { "$ref": "#/$defs/writer_state" }
      }
    },
    "writer_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "new_line", "new_line_text", "steps"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "new_line": { "enum": ["lf", "crlf"] },
        "new_line_text": { "enum": ["\n", "\r\n"] },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/writer_step" }
        }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "source_byte_position",
        "source_utf16_position",
        "line",
        "column_utf16"
      ],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "source_byte_position": { "$ref": "#/$defs/nonnegative_integer" },
        "source_utf16_position": { "$ref": "#/$defs/nonnegative_integer" },
        "line": { "$ref": "#/$defs/nonnegative_integer" },
        "column_utf16": { "$ref": "#/$defs/nonnegative_integer" }
      }
    },
    "source_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "text_utf8_bytes",
        "text_utf16_units",
        "positions"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string" },
        "text_utf8_bytes": { "$ref": "#/$defs/nonnegative_integer" },
        "text_utf16_units": { "$ref": "#/$defs/nonnegative_integer" },
        "positions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/position" }
        }
      }
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "kind",
        "kind_name",
        "text",
        "value_utf16_units",
        "start",
        "end"
      ],
      "properties": {
        "index": { "$ref": "#/$defs/nonnegative_integer" },
        "kind": { "$ref": "#/$defs/nonnegative_integer" },
        "kind_name": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "value_utf16_units": {
          "type": ["array", "null"],
          "items": { "type": "integer", "minimum": 0, "maximum": 65535 }
        },
        "start": { "$ref": "#/$defs/position" },
        "end": { "$ref": "#/$defs/position" }
      }
    },
    "output_end": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position_utf16", "line", "column_utf16"],
      "properties": {
        "position_utf16": { "$ref": "#/$defs/nonnegative_integer" },
        "line": { "$ref": "#/$defs/nonnegative_integer" },
        "column_utf16": { "$ref": "#/$defs/nonnegative_integer" }
      }
    },
    "printer_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file_name",
        "new_line",
        "source",
        "source_utf8_sha256",
        "output",
        "output_utf8_sha256",
        "output_utf16_units",
        "output_end",
        "tokens"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "file_name": { "type": "string", "minLength": 1 },
        "new_line": { "enum": ["lf", "crlf"] },
        "source": { "type": "string", "minLength": 1 },
        "source_utf8_sha256": { "$ref": "#/$defs/sha256" },
        "output": { "type": "string", "minLength": 1 },
        "output_utf8_sha256": { "$ref": "#/$defs/sha256" },
        "output_utf16_units": { "$ref": "#/$defs/positive_integer" },
        "output_end": { "$ref": "#/$defs/output_end" },
        "tokens": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/token" }
        }
      }
    }
  }
}
