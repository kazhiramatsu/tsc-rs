{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsc-rs.invalid/contracts/h2-7a-probe-traces.schema.json",
  "title": "H2.7a m-1 instrumented probe traces",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "phase",
    "generator",
    "contract",
    "witnesses",
    "base_sha256",
    "edit_table_sha256",
    "instrumented_output_sha256",
    "position_map_sha256",
    "case_manifest_fingerprint",
    "cases",
    "summary",
    "probe_traces_fingerprint_sha256"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "phase": {
      "const": "H2.7a-probe-traces"
    },
    "generator": {
      "$ref": "#/$defs/pathHash"
    },
    "contract": {
      "$ref": "#/$defs/pathHash"
    },
    "witnesses": {
      "$ref": "#/$defs/pathHash"
    },
    "base_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "edit_table_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "instrumented_output_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "position_map_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "case_manifest_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "probe_traces_fingerprint_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pathHash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "traceArgument": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "traceEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site_id",
        "args"
      ],
      "properties": {
        "site_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/traceArgument"
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "trace_events",
        "public_output_roll",
        "inert"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "trace_events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/traceEvent"
          }
        },
        "public_output_roll": {
          "$ref": "#/$defs/sha256"
        },
        "inert": {
          "const": true
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases",
        "events",
        "per_site_counts",
        "trace_content_roll"
      ],
      "properties": {
        "cases": {
          "type": "integer",
          "minimum": 1
        },
        "events": {
          "type": "integer",
          "minimum": 1
        },
        "per_site_counts": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "trace_content_roll": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
