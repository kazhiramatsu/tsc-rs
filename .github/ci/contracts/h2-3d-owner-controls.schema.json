{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kazhiramatsu/tsc-rs/.github/ci/contracts/h2-3d-owner-controls.schema.json",
  "title": "tsc-rs H2.3d JSON source owner controls",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "phase",
    "status",
    "typescript",
    "generator",
    "contract",
    "controls",
    "summary",
    "controls_fingerprint_sha256"
  ],
  "properties": {
    "schema": { "const": 1 },
    "phase": { "const": "H2.3d-json-source-owner-controls" },
    "status": { "const": "qualified" },
    "typescript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source_commit", "bundle", "implementation"],
      "properties": {
        "version": { "const": "6.0.3" },
        "source_commit": { "$ref": "#/$defs/sha1" },
        "bundle": { "$ref": "#/$defs/path_hash" },
        "implementation": { "$ref": "#/$defs/path_hash" }
      }
    },
    "generator": { "$ref": "#/$defs/path_hash" },
    "contract": { "$ref": "#/$defs/path_hash" },
    "controls": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": { "$ref": "#/$defs/control" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controls",
        "exact_outputs",
        "typescript_runs",
        "reported_diagnostics"
      ],
      "properties": {
        "controls": { "const": 14 },
        "exact_outputs": { "const": 13 },
        "typescript_runs": { "const": 28 },
        "reported_diagnostics": { "const": 2 }
      }
    },
    "controls_fingerprint_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "root", "utf8_base64", "utf8_sha256", "utf8_bytes"],
      "properties": {
        "path": { "type": "string", "pattern": "^/project/.+\\.(json|ts)$" },
        "root": { "const": true },
        "utf8_base64": { "type": "string" },
        "utf8_sha256": { "$ref": "#/$defs/sha256" },
        "utf8_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "compiler_options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ignoreDeprecations",
        "module",
        "moduleResolution",
        "newLine",
        "resolveJsonModule",
        "target"
      ],
      "properties": {
        "emitBOM": { "const": true },
        "ignoreDeprecations": { "const": "6.0" },
        "module": { "enum": [1, 2, 3, 4, 99, 100, 101, 102, 199, 200] },
        "moduleResolution": { "enum": [2, 3, 99, 100] },
        "newLine": { "enum": [0, 1] },
        "outDir": { "enum": ["/project", "/project/dist"] },
        "resolveJsonModule": { "const": true },
        "target": { "const": 99 }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_directory", "roots", "files", "compiler_options"],
      "properties": {
        "current_directory": { "const": "/project" },
        "roots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "type": "string", "pattern": "^/project/.+\\.(json|ts)$" }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/file" }
        },
        "compiler_options": { "$ref": "#/$defs/compiler_options" }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "category", "file", "start", "length", "message"],
      "properties": {
        "code": { "type": "integer", "minimum": 1 },
        "category": { "enum": ["Warning", "Error", "Suggestion", "Message"] },
        "file": { "type": ["string", "null"] },
        "start": { "type": ["integer", "null"], "minimum": 0 },
        "length": { "type": ["integer", "null"], "minimum": 0 },
        "message": { "type": "string" }
      }
    },
    "write": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "path",
        "kind",
        "callback_utf8_base64",
        "callback_utf8_sha256",
        "callback_utf8_bytes",
        "write_byte_order_mark",
        "materialized_utf8_sha256",
        "materialized_utf8_bytes",
        "on_error_callback_present",
        "source_files"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 1 },
        "path": { "type": "string", "pattern": "^/project/dist/.+\\.(json|js)$" },
        "kind": { "enum": ["json", "javascript"] },
        "callback_utf8_base64": { "type": "string" },
        "callback_utf8_sha256": { "$ref": "#/$defs/sha256" },
        "callback_utf8_bytes": { "type": "integer", "minimum": 0 },
        "write_byte_order_mark": { "type": "boolean" },
        "materialized_utf8_sha256": { "$ref": "#/$defs/sha256" },
        "materialized_utf8_bytes": { "type": "integer", "minimum": 0 },
        "on_error_callback_present": { "const": true },
        "source_files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "type": "string", "pattern": "^/project/.+\\.(json|ts)$" }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reported_diagnostics",
        "emit_diagnostics",
        "emit_skipped",
        "writes",
        "run_fingerprint_sha256"
      ],
      "properties": {
        "reported_diagnostics": {
          "type": "array",
          "maxItems": 1,
          "items": { "$ref": "#/$defs/diagnostic" }
        },
        "emit_diagnostics": { "const": [] },
        "emit_skipped": { "const": false },
        "writes": {
          "type": "array",
          "minItems": 0,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/write" }
        },
        "run_fingerprint_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_id",
        "input",
        "repetitions",
        "observation",
        "control_fingerprint_sha256"
      ],
      "properties": {
        "control_id": {
          "enum": [
            "multiline-lf-formatting-and-trailing-comma-rules",
            "crlf-input-bom-output-and-object-trailing-comma",
            "compact-text-escapes-and-nested-values",
            "amd-copy-is-module-invariant",
            "umd-copy-is-module-invariant",
            "system-copy-is-module-invariant",
            "node16-copy-is-module-invariant",
            "node18-copy-is-module-invariant",
            "node20-copy-is-module-invariant",
            "nodenext-copy-is-module-invariant",
            "json-without-outdir-is-not-emit-eligible",
            "same-location-json-output-is-suppressed",
            "empty-json-emits-empty-callback",
            "mixed-typescript-json-relocation-and-write-order"
          ]
        },
        "input": { "$ref": "#/$defs/input" },
        "repetitions": { "const": 2 },
        "observation": { "$ref": "#/$defs/observation" },
        "control_fingerprint_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
