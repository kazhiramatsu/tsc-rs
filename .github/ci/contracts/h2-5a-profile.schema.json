    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "typescript_repetitions",
        "rust_repetitions",
        "legal_worker_control",
        "denominator_control",
        "target_band_control",
        "disposal_scope_control",
        "generated_name_control",
        "class_fields_control",
        "decorator_binding_control",
        "module_interaction_control",
        "failure_control",
        "owner_controls",
        "h0_authority",
        "h1_authority",
        "l1_authority",
        "historical_h2_4b_profile",
        "local_full_gate",
        "hosted_gate",
        "hosted_gate_scope"
      ],
      "properties": {
        "typescript_repetitions": { "const": 2 },
        "rust_repetitions": { "const": 2 },
        "legal_worker_control": { "const": "h2_5a_cases_and_owner_controls_run_twice_in_isolated_programs" },
        "denominator_control": { "const": "h2_5a_exact_denominator_is_172_with_462_future_deferred_rows" },
        "target_band_control": { "const": "es2021_through_es2025_lower_esnext_syntax_while_esnext_preserves_it" },
        "disposal_scope_control": { "const": "sync_async_source_block_function_loop_and_namespace_disposal_scopes_are_exact" },
        "generated_name_control": { "const": "generated_env_error_and_result_names_follow_output_scope_ownership_and_collision_rules" },
        "class_fields_control": { "const": "es2021_es2022_field_auto_accessor_static_and_parameter_property_boundaries_are_exact" },
        "decorator_binding_control": { "const": "computed_receiver_parenthesis_and_lexical_super_bindings_are_exact" },
        "module_interaction_control": { "const": "esnext_and_commonjs_disposal_placement_helper_policy_and_exports_are_exact" },
        "failure_control": { "const": "five_later_owned_sources_fail_before_first_sink_write_and_no_emit_on_error_writes_nothing" },
