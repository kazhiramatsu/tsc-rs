        "interpretation": {
          "const": "H2.4b artifacts remain immutable lineage; current runtime ownership transfers to this H2.5a profile"
        }
      }
    },
    "qualification": { "$ref": "#/$defs/path_hash" },
    "runtime_inputs": {
      "type": "array",
      "minItems": 72,
      "maxItems": 72,
      "items": { "$ref": "#/$defs/path_hash" }
    },
    "admitted_profile": {
      "const": {
        "execution": "single-project-one-shot-whole-program",
        "target_states": ["ES2021(8)", "ES2022(9)", "ES2023(10)", "ES2024(11)", "ES2025(12)", "ESNext(99)"],
        "module_states": [
          "absent-effective-ESNext",
