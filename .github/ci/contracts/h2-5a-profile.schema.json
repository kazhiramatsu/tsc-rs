        "h0_authority": { "$ref": "#/$defs/path_hash" },
        "h1_authority": { "$ref": "#/$defs/path_hash" },
        "l1_authority": { "$ref": "#/$defs/path_hash" },
        "historical_h2_4b_profile": { "$ref": "#/$defs/path_hash" },
        "local_full_gate": { "const": "cargo xtask ci --baseline 59a9a7c5768a11cb2de082bd82e92c09a37f469f" },
        "hosted_gate": { "const": "cargo xtask acceptance" },
        "hosted_gate_scope": { "const": "fixed-unsplit-ts-tests-only" }
      }
