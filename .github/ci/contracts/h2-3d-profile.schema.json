{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kazhiramatsu/tsc-rs/.github/ci/contracts/h2-3d-profile.schema.json",
  "title": "tsc-rs H2.3d runtime profile transition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "kind", "status", "phase", "typescript", "generator", "contract",
    "origin", "qualification", "runtime_inputs", "admitted_profile", "transition",
    "evidence", "summary", "profile_fingerprint_sha256"
  ],
  "properties": {
    "schema": { "const": 1 },
    "kind": { "const": "h2-runtime-profile" },
    "status": { "const": "qualified" },
    "phase": { "const": "H2.3d" },
    "typescript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source_commit", "bundle", "implementation"],
      "properties": {
        "version": { "const": "6.0.3" },
        "source_commit": { "$ref": "#/$defs/sha1" },
        "bundle": { "$ref": "#/$defs/path_hash" },
        "implementation": { "$ref": "#/$defs/path_hash" }
      }
    },
    "generator": { "$ref": "#/$defs/path_hash" },
    "contract": { "$ref": "#/$defs/path_hash" },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trusted_h2_3c_merge", "historical", "interpretation"],
      "properties": {
        "trusted_h2_3c_merge": { "$ref": "#/$defs/sha1" },
        "historical": { "$ref": "#/$defs/historical" },
        "interpretation": {
          "const": "H2.3c artifacts remain immutable lineage; current runtime ownership transfers to this H2.3d profile"
        }
      }
    },
    "qualification": { "$ref": "#/$defs/path_hash" },
    "runtime_inputs": {
      "type": "array",
      "minItems": 63,
      "maxItems": 63,
      "items": { "$ref": "#/$defs/path_hash" }
    },
    "admitted_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution", "target", "module_states", "jsx_modes", "source_kinds", "products",
        "exact_cases", "h2_3d_exact_cases", "exact_reported_diagnostics", "exact_writes",
        "diagnostic_deferred_output_controls", "diagnostic_control_writes",
        "source_deferred_cases", "candidate_denominator", "h2_3d_candidate_denominator",
        "h2_3d_global_future_rows"
      ],
      "properties": {
        "execution": { "const": "single-project-one-shot-whole-program" },
        "target": { "const": "ESNext(99)" },
        "module_states": {
          "const": [
            "absent-effective-ESNext", "ESNext(99)", "CommonJS(1)", "AMD(2)",
            "UMD(3)", "System(4)", "Node16(100)", "Node18(101)",
            "Node20(102)", "NodeNext(199)"
          ]
        },
        "jsx_modes": {
          "const": ["Preserve(1)", "React(2)", "ReactNative(3)", "ReactJSX(4)", "ReactJSXDev(5)"]
        },
        "source_kinds": {
          "const": [".ts", ".mts", ".cts", ".tsx", ".js", ".mjs", ".cjs", ".jsx", ".json"]
        },
        "products": { "const": ["javascript", "mjs", "cjs", "jsx", "json"] },
        "exact_cases": { "const": 309 },
        "h2_3d_exact_cases": { "const": 0 },
        "exact_reported_diagnostics": { "const": 680 },
        "exact_writes": { "const": 404 },
        "diagnostic_deferred_output_controls": { "const": 5 },
        "diagnostic_control_writes": { "const": 5 },
        "source_deferred_cases": { "const": 0 },
        "candidate_denominator": { "const": 302 },
        "h2_3d_candidate_denominator": { "const": 0 },
        "h2_3d_global_future_rows": { "const": 695 }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_slice", "next_slice", "active_runtime_slices",
        "inactive_runtime_slice_count", "classic_jsx_tsx_owner",
        "automatic_jsx_runtime_owner", "json_output_owner", "decorators_owner",
        "general_output_matrix_owner", "h2_3d_candidate_cases",
        "h2_3d_global_future_rows", "h2_3d_future_dependency_groups",
        "deferred_failure_boundary"
      ],
      "properties": {
        "completed_slice": { "const": "H2.3d" },
        "next_slice": { "const": "H2.4a" },
        "active_runtime_slices": {
          "const": [
            "H2.1a", "H2.1b", "H2.1c", "H2.1d", "H2.1e", "H2.2a",
            "H2.2b", "H2.2c", "H2.2d", "H2.3a", "H2.3b", "H2.3c", "H2.3d"
          ]
        },
        "inactive_runtime_slice_count": { "const": 24 },
        "classic_jsx_tsx_owner": { "const": "complete" },
        "automatic_jsx_runtime_owner": { "const": "complete" },
        "json_output_owner": { "const": "complete" },
        "decorators_owner": { "const": "H2.4a" },
        "general_output_matrix_owner": { "const": "H2.8a" },
        "h2_3d_candidate_cases": { "const": 0 },
        "h2_3d_global_future_rows": { "const": 695 },
        "h2_3d_future_dependency_groups": { "const": 30 },
        "deferred_failure_boundary": { "const": "typed failure before first sink write" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "typescript_repetitions", "rust_repetitions", "legal_worker_control",
        "denominator_control", "json_text_control", "path_control",
        "module_interaction_control", "owner_matrix_control", "owner_controls",
        "h0_authority", "h1_authority", "l1_authority", "historical_h2_3c_profile",
        "local_full_gate", "hosted_gate", "hosted_gate_scope"
      ],
      "properties": {
        "typescript_repetitions": { "const": 2 },
        "rust_repetitions": { "const": 2 },
        "legal_worker_control": { "const": "h2_3d_owner_controls_run_twice_in_isolated_programs" },
        "denominator_control": {
          "const": "h2_3d_denominator_is_zero_after_h2_3c_dependency_closure_and_all_695_global_rows_retain_future_dependencies"
        },
        "json_text_control": {
          "const": "h2_3d_json_whitespace_trailing_commas_escapes_bom_and_newlines_match_typescript"
        },
        "path_control": {
          "const": "h2_3d_json_outdir_same_location_empty_and_mixed_write_order_match_typescript"
        },
        "module_interaction_control": {
          "const": "h2_3d_json_output_is_module_invariant_and_resolve_json_module_5070_5071_match_typescript"
        },
        "owner_matrix_control": {
          "const": "h2_3d_owner_controls_cover_text_paths_bom_newlines_modules_diagnostics_and_mixed_sources"
        },
        "owner_controls": { "$ref": "#/$defs/owner_controls" },
        "h0_authority": { "$ref": "#/$defs/path_hash" },
        "h1_authority": { "$ref": "#/$defs/path_hash" },
        "l1_authority": { "$ref": "#/$defs/path_hash" },
        "historical_h2_3c_profile": { "$ref": "#/$defs/path_hash" },
        "local_full_gate": {
          "const": "cargo xtask ci --baseline 9bc22c84a6c09149f31b9daa100e302d3730e6b2"
        },
        "hosted_gate": { "const": "cargo xtask acceptance" },
        "hosted_gate_scope": { "const": "fixed-unsplit-ts-tests-only" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_runtime_slices", "next_runtime_slices", "runtime_admissions",
        "executed_candidates", "h2_3d_executed_candidates", "h2_3d_global_future_rows",
        "unexecuted_candidates", "undispositioned_candidates",
        "historical_artifacts_reinterpreted"
      ],
      "properties": {
        "completed_runtime_slices": { "const": 13 },
        "next_runtime_slices": { "const": 1 },
        "runtime_admissions": { "const": 309 },
        "executed_candidates": { "const": 302 },
        "h2_3d_executed_candidates": { "const": 0 },
        "h2_3d_global_future_rows": { "const": 695 },
        "unexecuted_candidates": { "const": 0 },
        "undispositioned_candidates": { "const": 0 },
        "historical_artifacts_reinterpreted": { "const": 0 }
      }
    },
    "profile_fingerprint_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "historical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile", "qualification", "owner_controls", "profile_generator",
        "qualification_generator", "owner_controls_generator", "profile_contract",
        "qualification_contract", "owner_controls_contract"
      ],
      "properties": {
        "profile": { "$ref": "#/$defs/path_hash" },
        "qualification": { "$ref": "#/$defs/path_hash" },
        "owner_controls": { "$ref": "#/$defs/path_hash" },
        "profile_generator": { "$ref": "#/$defs/path_hash" },
        "qualification_generator": { "$ref": "#/$defs/path_hash" },
        "owner_controls_generator": { "$ref": "#/$defs/path_hash" },
        "profile_contract": { "$ref": "#/$defs/path_hash" },
        "qualification_contract": { "$ref": "#/$defs/path_hash" },
        "owner_controls_contract": { "$ref": "#/$defs/path_hash" }
      }
    },
    "owner_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "generator", "contract"],
      "properties": {
        "artifact": { "$ref": "#/$defs/path_hash" },
        "generator": { "$ref": "#/$defs/path_hash" },
        "contract": { "$ref": "#/$defs/path_hash" }
      }
    }
  }
}
