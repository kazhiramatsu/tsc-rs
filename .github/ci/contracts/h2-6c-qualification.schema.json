          "then": { "properties": { "required_slices": { "minItems": 1 }, "diagnostic_disposition": { "properties": { "state": { "const": "not-observed-source-deferred" } } }, "rust_expectation": { "const": "typed-failure-before-first-sink-write" } } }
        }
      ]
