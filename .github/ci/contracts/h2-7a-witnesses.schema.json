      "properties": {
        "version": {
          "const": "6.0.3"
        },
        "source_commit": {
          "const": "050880ce59e30b356b686bd3144efe24f875ebc8"
        },
        "bundle": {
          "$ref": "#/$defs/path_hash"
        },
        "implementation": {
          "$ref": "#/$defs/path_hash"
