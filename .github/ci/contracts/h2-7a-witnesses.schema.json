            "directives/references",
            "diagnostics channel",
            "printer grammar/shape",
            "NodeBuilder result contracts",
            "symbol tracking/accessibility",
            "syntactic-builder arms",
            "generated/global names",
            "AST identity/provenance",
            "upstream-observation controls"
