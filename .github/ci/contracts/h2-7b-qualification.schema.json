{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kazhiramatsu/tsc-rs/.github/ci/contracts/h2-7b-qualification.schema.json",
  "title": "H2.7b declaration-band qualification (m-1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "kind", "status", "phase", "typescript", "generator", "contract",
    "origin", "selection_contract", "inputs", "execution_contract", "owner_closure",
    "project_mount", "cases", "summary", "qualification_fingerprint_sha256"
  ],
  "properties": {
    "schema": { "const": 1 },
    "kind": { "const": "h2-7b-qualification" },
    "status": { "const": "qualified-typescript-oracle" },
    "phase": { "const": "H2.7b-declaration-observation" },
    "typescript": { "$ref": "#/$defs/typescript" },
    "generator": { "$ref": "#/$defs/path_hash" },
    "contract": { "$ref": "#/$defs/path_hash" },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["global_dispositions", "project_mount_decision"],
      "properties": {
        "global_dispositions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "cases_sha256"],
          "properties": {
            "path": { "const": "ratchets/h2-candidate-dispositions.v1.json" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "cases_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "project_mount_decision": { "const": "mounted-all-project-rows" }
      }
    },
    "selection_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_definition", "global_h2_7b_rows", "candidate_h2_7b_rows",
        "frozen_next_slice_rows", "census_disposition_roll_sha256", "candidate_cases_sha256",
        "global_candidate_denominator", "observed_candidate_denominator",
        "observed_admitted_denominator", "suite_counts", "candidate_suite_counts",
        "admitted_suite_counts", "deferred_suite_counts", "deferred_project_mount"
      ],
      "properties": {
        "candidate_definition": { "const": "the dispositions rows selected by the frozen H2.7b selector, split by the effective-option census; no applicability is re-derived by the acceptance runner" },
        "global_h2_7b_rows": { "const": 2456 },
        "candidate_h2_7b_rows": { "const": 1593 },
        "frozen_next_slice_rows": { "const": 1 },
        "census_disposition_roll_sha256": { "$ref": "#/$defs/sha256" },
        "candidate_cases_sha256": { "$ref": "#/$defs/sha256" },
        "global_candidate_denominator": { "const": 2456 },
        "observed_candidate_denominator": { "const": 1593 },
        "observed_admitted_denominator": { "const": 1567 },
        "suite_counts": { "$ref": "#/$defs/suite_counts_global" },
        "candidate_suite_counts": { "$ref": "#/$defs/suite_counts_candidate" },
        "admitted_suite_counts": { "$ref": "#/$defs/suite_counts_admitted" },
        "deferred_suite_counts": { "$ref": "#/$defs/suite_counts_deferred" },
        "deferred_project_mount": { "type": "array", "maxItems": 0, "items": { "type": "string" } }
      }
    },
    "inputs": { "$ref": "#/$defs/inputs" },
    "execution_contract": { "$ref": "#/$defs/execution_contract" },
    "owner_closure": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "oneOf": [{ "$ref": "#/$defs/owner_root" }, { "$ref": "#/$defs/owner_arm" }] }
    },
    "project_mount": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/project_mount" }]
    },
    "cases": {
      "type": "array",
      "minItems": 1593,
      "maxItems": 1593,
      "items": { "$ref": "#/$defs/case" }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "qualification_fingerprint_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "typescript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source_commit", "bundle", "implementation"],
      "properties": {
        "version": { "const": "6.0.3" },
        "source_commit": { "$ref": "#/$defs/sha1" },
        "bundle": { "$ref": "#/$defs/path_hash" },
        "implementation": { "$ref": "#/$defs/path_hash" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "git_blob_sha1"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "git_blob_sha1": { "$ref": "#/$defs/sha1" }
      }
    },
    "facet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "value", "raw", "origin"],
      "properties": {
        "state": { "enum": ["absent", "true", "false", "set"] },
        "value": { "type": ["boolean", "string", "null"] },
        "raw": { "type": ["string", "null"] },
        "origin": { "enum": ["absent", "virtual-config", "fixture", "matrix", "project-config", "descriptor"] }
      }
    },
    "option_facets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceMap", "inlineSourceMap", "inlineSources", "sourceRoot", "mapRoot"],
      "properties": {
        "sourceMap": { "$ref": "#/$defs/facet" },
        "inlineSourceMap": { "$ref": "#/$defs/facet" },
        "inlineSources": { "$ref": "#/$defs/facet" },
        "sourceRoot": { "$ref": "#/$defs/facet" },
        "mapRoot": { "$ref": "#/$defs/facet" }
      }
    },
    "rich_facet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "classification", "owners"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": {},
        "classification": { "enum": ["admitted", "deferred"] },
        "owners": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "category", "file", "start", "length", "message"],
      "properties": {
        "code": { "type": "integer", "minimum": 0 },
        "category": { "type": "string", "minLength": 1 },
        "file": { "type": ["string", "null"] },
        "start": { "type": ["integer", "null"], "minimum": 0 },
        "length": { "type": ["integer", "null"], "minimum": 0 },
        "message": { "type": "string" }
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "value": { "type": "string" } }
    },
    "symlink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["link_path", "target_path"],
      "properties": { "link_path": { "type": "string", "minLength": 1 }, "target_path": { "type": "string", "minLength": 1 } }
    },
    "input_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "path", "utf8_base64", "utf8_sha256", "utf8_bytes"],
      "properties": {
        "unit": { "type": "integer", "minimum": 0 },
        "path": { "type": "string", "minLength": 1 },
        "utf8_base64": { "type": "string" },
        "utf8_sha256": { "$ref": "#/$defs/sha256" },
        "utf8_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "input_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "utf8_base64", "utf8_sha256", "utf8_bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "utf8_base64": { "type": "string" },
        "utf8_sha256": { "$ref": "#/$defs/sha256" },
        "utf8_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_directory", "roots", "vfs_symlinks", "settings", "virtual_config", "files"],
      "properties": {
        "current_directory": { "type": "string", "minLength": 1 },
        "roots": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "vfs_symlinks": { "type": "array", "items": { "$ref": "#/$defs/symlink" } },
        "settings": { "type": "array", "items": { "$ref": "#/$defs/setting" } },
        "virtual_config": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/input_config" }] },
        "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/input_file" } }
      }
    },
    "feature_root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature", "start", "end", "kind"],
      "properties": {
        "feature": { "type": "string", "minLength": 1 },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "kind": { "type": "string", "minLength": 1 }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "script_kind", "declaration_file", "emit_eligible", "implied_module_format", "emit_module_format", "feature_roots", "parse_diagnostic_codes", "max_ast_depth", "import_attributes", "advanced_comment_placement", "text_sha256"],
      "properties": {
        "unit": { "type": "integer", "minimum": 0 },
        "path": { "type": "string", "minLength": 1 },
        "script_kind": { "type": "string", "minLength": 1 },
        "declaration_file": { "type": "boolean" },
        "emit_eligible": { "type": "boolean" },
        "implied_module_format": { "type": "string", "minLength": 1 },
        "emit_module_format": { "type": "integer" },
        "feature_roots": { "type": "array", "items": { "$ref": "#/$defs/feature_root" } },
        "parse_diagnostic_codes": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } },
        "max_ast_depth": { "type": "integer", "minimum": 1 },
        "import_attributes": { "type": "boolean" },
        "advanced_comment_placement": { "type": "boolean" },
        "text_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "inline_payload": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["data_uri_base64", "decoded_utf8_base64", "decoded_utf8_bytes", "decoded_utf8_sha256"],
          "properties": {
            "data_uri_base64": { "type": "string" },
            "decoded_utf8_base64": { "type": "string" },
            "decoded_utf8_bytes": { "type": "integer", "minimum": 0 },
            "decoded_utf8_sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      ]
    },
    "write": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "path", "kind", "callback_utf8_base64", "callback_utf8_sha256", "callback_utf8_bytes", "write_byte_order_mark", "materialized_utf8_base64", "materialized_utf8_sha256", "materialized_utf8_bytes", "on_error_callback_present", "source_files", "data_present", "data_source_map_url_pos", "data_diagnostics_count", "data_diagnostics", "inline_source_map_payload"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "path": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "callback_utf8_base64": { "type": "string" },
        "callback_utf8_sha256": { "$ref": "#/$defs/sha256" },
        "callback_utf8_bytes": { "type": "integer", "minimum": 0 },
        "write_byte_order_mark": { "type": "boolean" },
        "materialized_utf8_base64": { "type": "string" },
        "materialized_utf8_sha256": { "$ref": "#/$defs/sha256" },
        "materialized_utf8_bytes": { "type": "integer", "minimum": 0 },
        "on_error_callback_present": { "type": "boolean" },
        "source_files": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "data_present": { "type": "boolean" },
        "data_source_map_url_pos": { "type": ["integer", "null"], "minimum": 0 },
        "data_diagnostics_count": { "type": ["integer", "null"], "minimum": 0 },
        "data_diagnostics": { "oneOf": [{ "type": "null" }, { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }] },
        "inline_source_map_payload": { "$ref": "#/$defs/inline_payload" }
      }
    },
    "source_map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_source_file_names", "source_map_json", "source_map_json_utf8_base64", "source_map_json_utf8_sha256"],
      "properties": {
        "input_source_file_names": { "type": "array", "items": { "type": "string" } },
        "source_map_json": { "type": "string" },
        "source_map_json_utf8_base64": { "type": "string" },
        "source_map_json_utf8_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "emit_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["emit_skipped", "emit_refused", "diagnostics", "emitted_files", "source_maps"],
      "properties": {
        "emit_skipped": { "type": "boolean" },
        "emit_refused": { "type": "boolean" },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
        "emitted_files": { "oneOf": [{ "type": "null" }, { "type": "array", "items": { "type": "string" } }] },
        "source_maps": { "oneOf": [{ "type": "null" }, { "type": "array", "items": { "$ref": "#/$defs/source_map" } }] }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["writes", "reported_diagnostics", "emit_refused", "emit_result", "status_writes", "exit_code", "run_fingerprint_sha256"],
      "properties": {
        "api": { "type": "string", "minLength": 1 },
        "writes": { "type": "array", "items": { "$ref": "#/$defs/write" } },
        "reported_diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
        "emit_refused": { "type": "boolean" },
        "emit_result": { "$ref": "#/$defs/emit_result" },
        "status_writes": { "type": "array", "items": { "type": "string" } },
        "exit_code": { "type": "integer", "minimum": 0 },
        "transpile_outputs": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "run_fingerprint_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "owner_root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "role", "owner_slice", "disposition", "activation", "declaration"],
      "properties": {
        "key": { "enum": ["declaration-output-path", "declaration-output-name"] },
        "role": { "type": "string", "minLength": 1 },
        "owner_slice": { "const": "H2.7b" },
        "disposition": { "const": "deferred-h2" },
        "activation": { "type": "string", "minLength": 1 },
        "declaration": { "type": "object", "additionalProperties": true }
      }
    },
    "line_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": { "start": { "type": "integer", "minimum": 1 }, "end": { "type": "integer", "minimum": 1 } }
    },
    "arm_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "sha256"],
      "properties": { "start": { "type": "integer", "minimum": 1 }, "end": { "type": "integer", "minimum": 1 }, "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "shared_line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "owners"],
      "properties": {
        "start": { "type": "integer", "minimum": 1 },
        "end": { "type": "integer", "minimum": 1 },
        "owners": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "arm_dependency": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["name", "owner"],
          "properties": { "name": { "type": "string", "minLength": 1 }, "owner": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["lines", "owner"],
          "properties": { "lines": { "$ref": "#/$defs/line_range" }, "owner": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "owner_arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "enclosure", "ranges", "shared_lines", "owner_slice", "disposition", "role", "activation", "consumers", "dependencies"],
      "properties": {
        "key": { "enum": ["declaration-source-output-paths", "declaration-emit", "declaration-write", "declaration-collision-preflight"] },
        "enclosure": {
          "type": "object", "additionalProperties": false, "required": ["name", "start_line", "range", "sha256"],
          "properties": { "name": { "type": "string", "minLength": 1 }, "start_line": { "type": "integer", "minimum": 1 }, "range": { "$ref": "#/$defs/line_range" }, "sha256": { "$ref": "#/$defs/sha256" } }
        },
        "ranges": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/arm_range" } },
        "shared_lines": { "type": "array", "items": { "$ref": "#/$defs/shared_line" } },
        "owner_slice": { "const": "H2.7b" },
        "disposition": { "const": "deferred-h2" },
        "role": { "type": "string", "minLength": 1 },
        "activation": { "type": "string", "minLength": 1 },
        "consumers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "dependencies": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/arm_dependency" } }
      }
    },
    "root_selection": { "type": "object", "additionalProperties": true, "required": ["state"], "properties": { "state": { "enum": ["explicit-inputs", "project-config", "discovered-config"] } } },
    "project_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["descriptor", "current_directory", "root_selection", "module_variant", "config_diagnostics", "mount_fingerprint", "analyzed_files"],
      "properties": {
        "descriptor": { "type": "object", "additionalProperties": true, "required": ["path", "scenario", "project_root"], "properties": { "path": { "type": "string", "minLength": 1 }, "scenario": { "type": "string" }, "project_root": { "type": "string", "minLength": 1 } } },
        "current_directory": { "type": "string", "minLength": 1 },
        "root_selection": { "$ref": "#/$defs/root_selection" },
        "module_variant": { "type": "object", "additionalProperties": false, "required": ["name", "value"], "properties": { "name": { "enum": ["amd", "commonjs"] }, "value": { "enum": [1, 2] } } },
        "config_diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
        "mount_fingerprint": { "$ref": "#/$defs/sha256" },
        "analyzed_files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite", "case_id", "fixture_id", "matrix_key", "selection_origin", "execution_route", "expansion_case", "configuration_index", "source", "option_facets", "positive_options", "explicit_false_options", "effective_declaration_options", "facets", "disposition", "emit_eligibility", "first_owner", "required_slices", "reason", "target_state", "module_state", "observation_input_sha256", "owner_reachability", "diagnostic_disposition", "rust_expectation", "case_fingerprint_sha256"],
      "properties": {
        "suite": { "enum": ["compiler", "conformance", "project", "transpile"] },
        "case_id": { "type": "string", "minLength": 1 },
        "fixture_id": { "type": "string", "minLength": 1 },
        "matrix_key": { "type": "string", "minLength": 1 },
        "selection_origin": { "const": "dispositions-h2-7b-candidate" },
        "execution_route": { "enum": ["recorded-compiler-plan", "qualified-vfs", "project-mount", "transpile-api"] },
        "expansion_case": { "type": ["integer", "null"], "minimum": 0 },
        "configuration_index": { "type": ["integer", "null"], "minimum": 0 },
        "source": { "$ref": "#/$defs/source" },
        "option_facets": { "$ref": "#/$defs/option_facets" },
        "positive_options": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "explicit_false_options": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "effective_declaration_options": { "type": "object", "additionalProperties": true },
        "facets": { "type": "array", "items": { "$ref": "#/$defs/rich_facet" } },
        "disposition": { "enum": ["admitted-for-execution", "deferred-to-slices"] },
        "emit_eligibility": { "type": ["string", "null"], "enum": ["emit-eligible", "no-emit-eligible-source", null] },
        "first_owner": { "type": ["string", "null"], "minLength": 1 },
        "required_slices": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "reason": { "type": "string", "minLength": 1 },
        "target_state": { "type": "string", "minLength": 1 },
        "module_state": { "type": "string", "minLength": 1 },
        "observation_input_sha256": { "$ref": "#/$defs/sha256" },
        "input": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/input" }] },
        "files": { "oneOf": [{ "type": "null" }, { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } }] },
        "project_input": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/project_input" }] },
        "transpile_input": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": true }] },
        "owner_reachability": { "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "diagnostic_disposition": { "type": "object", "additionalProperties": false, "required": ["state"], "properties": { "state": { "enum": ["exact-required", "not-observed-source-deferred"] } } },
        "typescript_observation": { "$ref": "#/$defs/run" },
        "typescript_run_fingerprints": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/sha256" } },
        "rust_expectation": { "enum": ["two-deterministic-exact-runs", "typed-failure-before-first-sink-write"] },
        "case_fingerprint_sha256": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        { "if": { "properties": { "suite": { "const": "compiler" } } }, "then": { "properties": { "execution_route": { "const": "recorded-compiler-plan" }, "input": { "type": "object" }, "files": { "type": "array" } } } },
