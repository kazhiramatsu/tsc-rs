{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kazhiramatsu/tsc-rs/.github/ci/contracts/h2-3c-profile.schema.json",
  "title": "tsc-rs H2.3c runtime profile transition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "status",
    "phase",
    "typescript",
    "generator",
    "contract",
    "origin",
    "qualification",
    "runtime_inputs",
    "admitted_profile",
    "transition",
    "evidence",
    "summary",
    "profile_fingerprint_sha256"
  ],
  "properties": {
    "schema": { "const": 1 },
    "kind": { "const": "h2-runtime-profile" },
    "status": { "const": "qualified" },
    "phase": { "const": "H2.3c" },
    "typescript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source_commit", "bundle", "implementation"],
      "properties": {
        "version": { "const": "6.0.3" },
        "source_commit": { "$ref": "#/$defs/sha1" },
        "bundle": { "$ref": "#/$defs/path_hash" },
        "implementation": { "$ref": "#/$defs/path_hash" }
      }
    },
    "generator": { "$ref": "#/$defs/path_hash" },
    "contract": { "$ref": "#/$defs/path_hash" },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trusted_h2_3b_merge", "historical", "interpretation"],
      "properties": {
        "trusted_h2_3b_merge": { "$ref": "#/$defs/sha1" },
        "historical": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "qualification",
            "owner_controls",
            "profile_generator",
            "qualification_generator",
            "owner_controls_generator",
            "profile_contract",
            "qualification_contract",
            "owner_controls_contract"
          ],
          "properties": {
            "profile": { "$ref": "#/$defs/path_hash" },
            "qualification": { "$ref": "#/$defs/path_hash" },
            "owner_controls": { "$ref": "#/$defs/path_hash" },
            "profile_generator": { "$ref": "#/$defs/path_hash" },
            "qualification_generator": { "$ref": "#/$defs/path_hash" },
            "owner_controls_generator": { "$ref": "#/$defs/path_hash" },
            "profile_contract": { "$ref": "#/$defs/path_hash" },
            "qualification_contract": { "$ref": "#/$defs/path_hash" },
            "owner_controls_contract": { "$ref": "#/$defs/path_hash" }
          }
        },
        "interpretation": {
          "const": "H2.3b artifacts remain immutable lineage; current runtime ownership transfers to this H2.3c profile"
        }
      }
    },
    "qualification": { "$ref": "#/$defs/path_hash" },
    "runtime_inputs": {
      "type": "array",
      "minItems": 60,
      "maxItems": 60,
      "items": { "$ref": "#/$defs/path_hash" }
    },
    "admitted_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution",
        "target",
        "module_states",
        "jsx_modes",
        "source_kinds",
        "products",
        "exact_cases",
        "h2_3c_exact_cases",
        "exact_reported_diagnostics",
        "exact_writes",
        "diagnostic_deferred_output_controls",
        "diagnostic_control_writes",
        "source_deferred_cases",
        "candidate_denominator",
        "h2_3c_candidate_denominator"
      ],
      "properties": {
        "execution": { "const": "single-project-one-shot-whole-program" },
        "target": { "const": "ESNext(99)" },
        "module_states": {
          "const": [
            "absent-effective-ESNext",
            "ESNext(99)",
            "CommonJS(1)",
            "AMD(2)",
            "UMD(3)",
            "System(4)",
            "Node16(100)",
            "Node18(101)",
            "Node20(102)",
            "NodeNext(199)"
          ]
        },
        "jsx_modes": {
          "const": [
            "Preserve(1)",
            "React(2)",
            "ReactNative(3)",
            "ReactJSX(4)",
            "ReactJSXDev(5)"
          ]
        },
        "source_kinds": {
          "const": [".ts", ".mts", ".cts", ".tsx", ".js", ".mjs", ".cjs", ".jsx"]
        },
        "products": { "const": ["javascript", "mjs", "cjs", "jsx"] },
        "exact_cases": { "const": 309 },
        "h2_3c_exact_cases": { "const": 4 },
        "exact_reported_diagnostics": { "const": 680 },
        "exact_writes": { "const": 404 },
        "diagnostic_deferred_output_controls": { "const": 5 },
        "diagnostic_control_writes": { "const": 5 },
        "source_deferred_cases": { "const": 0 },
        "candidate_denominator": { "const": 302 },
        "h2_3c_candidate_denominator": { "const": 4 }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_slice",
        "next_slice",
        "active_runtime_slices",
        "inactive_runtime_slice_count",
        "classic_jsx_tsx_owner",
        "automatic_jsx_runtime_owner",
        "json_output_owner",
        "general_output_matrix_owner",
        "h2_3c_deferred_slices",
        "h2_3c_deferred_cases",
        "inherited_h2_3b_residual_slices",
        "inherited_h2_3b_residual_cases",
        "deferred_failure_boundary"
      ],
      "properties": {
        "completed_slice": { "const": "H2.3c" },
        "next_slice": { "const": "H2.3d" },
        "active_runtime_slices": {
          "const": [
            "H2.1a",
            "H2.1b",
            "H2.1c",
            "H2.1d",
            "H2.1e",
            "H2.2a",
            "H2.2b",
            "H2.2c",
            "H2.2d",
            "H2.3a",
            "H2.3b",
            "H2.3c"
          ]
        },
        "inactive_runtime_slice_count": { "const": 25 },
        "classic_jsx_tsx_owner": { "const": "complete" },
        "automatic_jsx_runtime_owner": { "const": "complete" },
        "json_output_owner": { "const": "H2.3d" },
        "general_output_matrix_owner": { "const": "H2.8a" },
        "h2_3c_deferred_slices": { "const": [] },
        "h2_3c_deferred_cases": { "const": 0 },
        "inherited_h2_3b_residual_slices": { "const": [] },
        "inherited_h2_3b_residual_cases": { "const": 0 },
        "deferred_failure_boundary": {
          "const": "typed failure before first sink write"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "typescript_repetitions",
        "rust_repetitions",
        "legal_worker_control",
        "denominator_control",
        "automatic_transform_control",
        "development_runtime_control",
        "import_source_control",
        "module_interaction_control",
        "historical_residual_control",
        "owner_matrix_control",
        "owner_controls",
        "h0_authority",
        "h1_authority",
        "l1_authority",
        "historical_h2_3b_profile",
        "local_full_gate",
        "hosted_gate",
        "hosted_gate_scope"
      ],
      "properties": {
        "typescript_repetitions": { "const": 2 },
        "rust_repetitions": { "const": 2 },
        "legal_worker_control": {
          "const": "h2_3c_two_worker_execution_is_exact_and_isolated"
        },
        "denominator_control": {
          "const": "h2_3c_denominator_is_the_four_h2_3b_source_deferred_rows"
        },
        "automatic_transform_control": {
          "const": "h2_3c_jsx_jsxs_fragments_keys_children_and_spread_fallback_match_typescript"
        },
        "development_runtime_control": {
          "const": "h2_3c_jsxdev_source_metadata_static_children_and_name_collisions_match_typescript"
        },
        "import_source_control": {
          "const": "h2_3c_option_and_pragma_import_source_and_runtime_precedence_match_typescript"
        },
        "module_interaction_control": {
          "const": "h2_3c_esm_commonjs_and_system_helper_import_projections_match_typescript"
        },
        "historical_residual_control": {
          "const": "h2_3c_h2_3b_source_deferred_rows_are_exactly_promoted"
        },
        "owner_matrix_control": {
          "const": "h2_3c_owner_controls_cover_runtimes_imports_pragmas_extensions_and_modules"
        },
        "owner_controls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact", "generator", "contract"],
          "properties": {
            "artifact": { "$ref": "#/$defs/path_hash" },
            "generator": { "$ref": "#/$defs/path_hash" },
            "contract": { "$ref": "#/$defs/path_hash" }
          }
        },
        "h0_authority": { "$ref": "#/$defs/path_hash" },
        "h1_authority": { "$ref": "#/$defs/path_hash" },
        "l1_authority": { "$ref": "#/$defs/path_hash" },
        "historical_h2_3b_profile": { "$ref": "#/$defs/path_hash" },
        "local_full_gate": {
          "const": "cargo xtask ci --baseline 7aaaa414133d630180931dd79cd9169d43e54121"
        },
        "hosted_gate": { "const": "cargo xtask acceptance" },
        "hosted_gate_scope": { "const": "fixed-unsplit-ts-tests-only" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_runtime_slices",
        "next_runtime_slices",
        "runtime_admissions",
        "executed_candidates",
        "h2_3c_executed_candidates",
        "unexecuted_candidates",
        "undispositioned_candidates",
        "historical_artifacts_reinterpreted"
      ],
      "properties": {
        "completed_runtime_slices": { "const": 12 },
        "next_runtime_slices": { "const": 1 },
        "runtime_admissions": { "const": 309 },
        "executed_candidates": { "const": 302 },
        "h2_3c_executed_candidates": { "const": 4 },
        "unexecuted_candidates": { "const": 0 },
        "undispositioned_candidates": { "const": 0 },
        "historical_artifacts_reinterpreted": { "const": 0 }
      }
    },
    "profile_fingerprint_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
