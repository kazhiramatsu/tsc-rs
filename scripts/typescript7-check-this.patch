+			}
+			if os.Getenv("TSRS_TRACE_STACK") == "1" {
+				tsrsTraceThisStack.Do(func() { fmt.Fprintf(os.Stderr, "TSRS_TRACE stack\n%s", runtimedebug.Stack()) })
+			}
+		}
+	}
