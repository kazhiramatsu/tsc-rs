From 5bcb2c6007511d649a79336c7bc85c29f358f087 Mon Sep 17 00:00:00 2001
From: kazhiramatsu <kazutakehiramatsu@gmail.com>
Date: Fri, 11 Sep 2026 20:05:15 +0900
Subject: [PATCH] fix(emitter): merge decorator hoists after a function body's
 prologue directives

tsc-port: visitFunctionBody @6.0.3 (_tsc.js:91277-91290) ->
mergeLexicalEnvironment (24889-24936): the hoisted `var` statement of a
function or arrow body splices at leftHoistedFunctionsEnd, after the
standard prologue directives and after custom-prologue hoisted function
declarations of earlier transforms. `merge_block_environment` inserted it
at index 0, so a body opening with `"use strict"; "custom directive";`
printed `var _a;` first and the directives ceased to be directives.

The source-file merge already scanned both spans; the scan is now shared
(`hoisted_declaration_insertion_index`) by `merge_source_file_environment`
and `merge_block_environment`. A block synthesized by
convertToFunctionBlock has no prologue and keeps index 0. This is the
decorator pass's own splice; the CustomPrologue flag read by later passes
is a separate cause with its own witnesses.

Focused run (lexical-prologue, 24 commands): 24 exact twice, exit 0,
sources and witness inputs unchanged after the run
(ratchets/h2-8a-decorator-literal-prologue-cause3-focused.v1.json).
---
 .../src/builtins/standard_decorators.rs       |  42 +++--
 ...or-literal-prologue-cause3-focused.v1.json | 174 ++++++++++++++++++
 2 files changed, 205 insertions(+), 11 deletions(-)
 create mode 100644 ratchets/h2-8a-decorator-literal-prologue-cause3-focused.v1.json

diff --git a/crates/emitter/src/builtins/standard_decorators.rs b/crates/emitter/src/builtins/standard_decorators.rs
index c20de0d40..71e62e77e 100644
--- a/crates/emitter/src/builtins/standard_decorators.rs
+++ b/crates/emitter/src/builtins/standard_decorators.rs
@@ -5807,13 +5807,7 @@ impl<'context> StandardDecoratorVisitor<'context> {
             });
         };
         let mut statements = self.array_nodes(data.statements)?;
-        let mut index = 0;
-        while index < statements.len() && self.is_prologue_directive(statements[index])? {
-            index += 1;
-        }
-        while index < statements.len() && self.is_hoisted_function(statements[index])? {
-            index += 1;
-        }
+        let index = self.hoisted_declaration_insertion_index(&statements)?;
         statements.insert(index, declaration);
         let statements = if let Some(original) = data.statements.map(|array| self.array(array)) {
             self.context
@@ -5837,6 +5831,29 @@ impl<'context> StandardDecoratorVisitor<'context> {
             .node())
     }
 
+    /// tsc-port: mergeLexicalEnvironment @6.0.3 — `leftHoistedFunctionsEnd`:
+    /// the hoisted `var` statement (the only declaration this transform
+    /// produces) splices after the standard prologue directives
+    /// (`isPrologueDirective` span) and after the custom-prologue hoisted
+    /// function declarations of earlier transforms (`isHoistedFunction`
+    /// span), before any statement that follows, including hoisted `var`
+    /// statements already there. Function bodies and the source file share
+    /// this rule; a block synthesized by `convertToFunctionBlock` has no
+    /// prologue and takes index 0.
+    fn hoisted_declaration_insertion_index(
+        &self,
+        statements: &[TransformNode],
+    ) -> Result<usize, TransformError> {
+        let mut index = 0;
+        while index < statements.len() && self.is_prologue_directive(statements[index])? {
+            index += 1;
+        }
+        while index < statements.len() && self.is_hoisted_function(statements[index])? {
+            index += 1;
+        }
+        Ok(index)
+    }
+
     /// tsc-port: isPrologueDirective @6.0.3
     fn is_prologue_directive(&self, node: TransformNode) -> Result<bool, TransformError> {
         let arena = self.context.arena();
@@ -5868,9 +5885,11 @@ impl<'context> StandardDecoratorVisitor<'context> {
 
     /// tsc-port: visitFunctionBody / mergeLexicalEnvironment @6.0.3
     ///
-    /// Declares the temporaries hoisted while visiting a block body at the
-    /// start of that block (static block and function-like bodies have no
-    /// prologue directives here).
+    /// Declares the temporaries hoisted while visiting a block body inside
+    /// that block, after its standard prologue directives (a function or
+    /// arrow body may open with `"use strict"` and further directives) and
+    /// after custom-prologue hoisted functions, as `mergeLexicalEnvironment`
+    /// splices `leftHoistedFunctionsEnd`.
     fn merge_block_environment(
         &mut self,
         body: TransformNode,
@@ -5886,7 +5905,8 @@ impl<'context> StandardDecoratorVisitor<'context> {
             });
         };
         let mut statements = self.array_nodes(data.statements)?;
-        statements.insert(0, declaration);
+        let index = self.hoisted_declaration_insertion_index(&statements)?;
+        statements.insert(index, declaration);
         let statements = if let Some(original) = data.statements.map(|array| self.array(array)) {
             self.context
                 .factory()?
