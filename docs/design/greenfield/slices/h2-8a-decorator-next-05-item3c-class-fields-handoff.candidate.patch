             let (key_expression, evaluation) = if let Some(left) = assignment_left {
                 (self.context.factory()?.clone_node(left)?, Some(expression))
             } else {
diff --git a/crates/emitter/src/builtins/standard_decorators.rs b/crates/emitter/src/builtins/standard_decorators.rs
