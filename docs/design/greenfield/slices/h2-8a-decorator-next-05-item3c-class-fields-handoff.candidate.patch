@@ -1778,6 +1787,10 @@ impl<'context> StandardDecoratorVisitor<'context> {
             prologue.push(self.create_let(name, Some(initializer))?);
         }
         definitions.splice(0..0, prologue);
+        if class_fields_owns_set_function_name {
