+    /// Open a parked request buffer: until the matching
+    /// `resume_emit_helper_requests`, new unscoped helper requests (those not
+    /// already in the file's list) are collected instead of appended, in
+    /// request order and without duplicates. Buffers nest; a request made
+    /// while an inner buffer is open belongs to that inner buffer.
+    pub fn defer_emit_helper_requests(&mut self) -> Result<(), TransformError> {
+        self.require_transforming("defer emit helper requests")?;
+        self.deferred_emit_helper_requests.push(Vec::new());
+        Ok(())
+    }
+
+    /// Close the innermost parked request buffer and hand its requests back
+    /// to the caller, which re-issues them through `request_emit_helper` at
+    /// the point where tsc would have made them (deduplication against the
+    /// requests made in the meantime happens there).
+    pub fn resume_emit_helper_requests(&mut self) -> Result<Vec<EmitHelper>, TransformError> {
