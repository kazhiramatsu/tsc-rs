{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kazhiramatsu/tsc-rs/.github/ci/contracts/h2-8a-observations.schema.json",
  "title": "H2.8a complete TypeScript reference commands",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "typescript",
    "source_commit",
    "status",
    "repetitions",
    "generator",
    "inputs",
    "execution_contract",
    "cases",
    "summary"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "kind": {
      "const": "h2-8a-observations"
    },
    "typescript": {
      "const": "6.0.3"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "status": {
      "const": "typescript-reference-only"
    },
    "repetitions": {
      "const": 2
    },
    "generator": {
      "allOf": [
        {
          "$ref": "#/$defs/identity"
        },
        {
          "properties": {
            "path": {
              "const": "crates/oracle/h2-8a-observations.mjs"
            }
          },
          "required": [
            "path"
          ]
        }
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identity"
      },
      "minItems": 7,
      "maxItems": 7
    },
    "execution_contract": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case"
      },
      "minItems": 809,
      "maxItems": 809
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "whole_program_candidates",
        "repetitions",
        "deterministic_cases",
        "typescript_runs",
        "transpile_controls_not_executed",
        "runtime_admitted",
        "writes",
        "emit_skipped"
      ],
      "properties": {
        "whole_program_candidates": {
          "const": 809
        },
        "repetitions": {
          "const": 2
        },
        "deterministic_cases": {
          "const": 809
        },
        "typescript_runs": {
          "const": 1618
        },
        "transpile_controls_not_executed": {
          "const": 0
        },
        "runtime_admitted": {
          "const": 0
        },
        "writes": {
          "type": "integer",
          "minimum": 0
        },
        "emit_skipped": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256",
        "git_blob_sha1"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "git_blob_sha1": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "text"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "category",
        "file",
        "start",
        "length",
        "message",
        "related_information"
      ],
      "properties": {
        "code": {
          "type": "integer",
          "minimum": 0
        },
        "category": {
          "enum": [
            "Warning",
            "Error",
            "Suggestion",
            "Message"
          ]
        },
        "file": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "start": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "length": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "message": {
          "type": "string"
        },
        "related_information": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/related_diagnostic"
              }
            }
          ]
        }
      }
    },
    "write": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "path",
        "kind",
        "callback_utf8_base64",
        "callback_utf8_bytes",
        "write_byte_order_mark",
        "materialized_utf8_base64",
        "materialized_utf8_bytes",
        "on_error_callback_present",
        "source_files",
        "data_present",
        "data_keys",
        "data_source_map_url_pos",
        "data_diagnostics",
        "data_build_info"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "javascript",
            "mjs",
            "cjs",
            "declaration",
            "source-map",
            "declaration-map",
            "build-info"
          ]
        },
        "callback_utf8_base64": {
          "type": "string"
        },
        "callback_utf8_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "write_byte_order_mark": {
          "type": "boolean"
        },
        "materialized_utf8_base64": {
          "type": "string"
        },
        "materialized_utf8_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "on_error_callback_present": {
          "type": "boolean"
        },
        "source_files": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "data_present": {
          "type": "boolean"
        },
        "data_keys": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "data_source_map_url_pos": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "data_diagnostics": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/diagnostic"
              }
            }
          ]
        },
        "data_build_info": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "source_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_source_file_names",
        "source_map_json"
      ],
      "properties": {
        "input_source_file_names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_map_json": {
          "type": "string"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program_source_order",
        "standard_libraries",
        "writes",
        "reported_diagnostics",
        "emit_refused",
        "emit_result",
        "status_writes",
        "exit_code"
      ],
      "properties": {
        "program_source_order": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "standard_libraries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "writes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/write"
          }
        },
        "reported_diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "emit_refused": {
          "type": "boolean"
        },
        "emit_result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "emit_skipped",
            "diagnostics",
            "emitted_files",
            "source_maps"
          ],
          "properties": {
            "emit_skipped": {
              "type": "boolean"
            },
            "diagnostics": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/diagnostic"
              }
            },
            "emitted_files": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              ]
            },
            "source_maps": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/source_map"
                  }
                }
              ]
            }
          }
        },
        "status_writes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exit_code": {
          "enum": [
            0,
            1,
            2
          ]
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "input_sha256",
        "required_slices",
        "disposition",
        "typescript_observation",
        "repetitions"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "required_slices": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^H2\\."
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "disposition": {
          "const": "typescript-reference-only"
        },
        "typescript_observation": {
          "$ref": "#/$defs/observation"
        },
        "repetitions": {
          "const": 2
        }
      }
    },
    "related_diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "category",
        "file",
        "start",
        "length",
        "message",
        "related_information"
      ],
      "properties": {
        "code": {
          "type": "integer",
          "minimum": 0
        },
        "category": {
          "enum": [
            "Warning",
            "Error",
            "Suggestion",
            "Message"
          ]
        },
        "file": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "start": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "length": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "message": {
          "type": "string"
        },
        "related_information": {
          "type": "null"
        }
      }
    }
  }
}
