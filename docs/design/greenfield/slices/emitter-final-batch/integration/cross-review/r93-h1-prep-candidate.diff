+// Accept an injected source reader so a single scan reports every broken
+// reference, including missing files and non-unique needles.
+export function collectAnchorFailures(specs, sourceFor) {
+  const failures = [];
+  const ids = new Set();
+  for (const [id, relative, needle] of specs) {
+    if (ids.has(id)) failures.push(`duplicate anchor identifier ${id}`);
+    ids.add(id);
+    let text;
+    try { text = sourceFor(relative); }
+    catch (error) { failures.push(`cannot read anchor ${id} in ${relative}: ${error.message}`); continue; }
+    const offset = text.indexOf(needle);
+    if (offset < 0) failures.push(`missing anchor ${id} in ${relative}`);
+    else if (text.indexOf(needle, offset + 1) >= 0)
+      failures.push(`anchor ${id} is not unique in ${relative}`);
+  }
+  return failures;
+}
