+    /// The `setterName` / `propertyName` operand of a super property: the
+    /// visited element key, or the identifier name as a string literal
+    /// (createStringLiteralFromNode). `None` for a private name.
+    fn super_property_key(
+        &mut self,
+        node: TransformNode,
+    ) -> Result<Option<TransformNode>, TransformError> {
+        match self.context.arena().node(node)?.data.clone() {
+            NodeData::ElementAccessExpression(data) => {
+                let key = data
+                    .argument_expression
+                    .ok_or(TransformError::RequiredChildRemoved {
+                        parent: SyntaxKind::ElementAccessExpression,
+                        field: "argument expression",
+                    })?;
+                Ok(Some(self.visit_required(
+                    key,
+                    SyntaxKind::ElementAccessExpression,
+                    "argument expression",
+                )?))
+            }
+            NodeData::PropertyAccessExpression(data) => {
+                let name = data.name.ok_or(TransformError::RequiredChildRemoved {
+                    parent: SyntaxKind::PropertyAccessExpression,
+                    field: "name",
+                })?;
+                let name = self.node(name);
+                if !matches!(
+                    self.context.arena().node(name)?.data,
+                    NodeData::Identifier(_)
+                ) {
+                    return Ok(None);
+                }
+                Ok(Some(self.create_string_literal_from_node(name)?))
+            }
+            _ => Ok(None),
