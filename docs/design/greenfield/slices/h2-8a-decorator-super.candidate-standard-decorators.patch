+    /// The `getterName`/`setterName` pair of a read-modify-write: a simple
+    /// inlineable key is copied (tsc reuses the one node), any other key is
+    /// cached in a hoisted temp whose initializing assignment becomes the
+    /// setter key.
+    fn split_super_key_for_read_write(
+        &mut self,
+        setter_name: TransformNode,
+    ) -> Result<(TransformNode, TransformNode), TransformError> {
+        if self.is_simple_inlineable_expression(setter_name)? {
+            let getter_name = self.context.factory()?.clone_node(setter_name)?;
+            self.context
+                .factory()?
+                .set_text_range(getter_name, setter_name)?;
+            return Ok((getter_name, setter_name));
+        }
+        let temp = self.allocate_hoisted_super_temp()?;
+        let getter_name = self.create_temp_identifier(&temp)?;
+        let target = self.create_temp_identifier(&temp)?;
+        let setter_name = self.create_assignment(target, setter_name)?;
+        Ok((getter_name, setter_name))
+    }
+
+    /// tsc-port: visitBinaryExpression (super property assignment) @6.0.3
+    #[allow(clippy::too_many_arguments)]
+    fn lower_super_assignment(
+        &mut self,
+        original: TransformNode,
+        left: TransformNode,
+        right: Option<NodeId>,
+        operator: SyntaxKind,
+        value_use: ExpressionValueUse,
+        setter_name: TransformNode,
+        class_this: TransformNode,
+        class_super: TransformNode,
+    ) -> Result<NodeId, TransformError> {
+        let right = right.ok_or(TransformError::RequiredChildRemoved {
+            parent: SyntaxKind::BinaryExpression,
+            field: "right",
+        })?;
+        let mut expression = self.visit_required(right, SyntaxKind::BinaryExpression, "right")?;
+        let setter_name = if Self::is_compound_assignment(operator) {
+            let (getter_name, setter_name) = self.split_super_key_for_read_write(setter_name)?;
+            let super_target = self.create_class_super_reference(class_super)?;
+            let receiver = self.clone_receiver_class_this(class_this)?;
+            let super_property_get =
+                self.create_reflect_get_call(super_target, getter_name, receiver)?;
+            self.set_original_and_range(super_property_get, left)?;
+            expression = self.create_binary(
+                super_property_get,
+                Self::non_assignment_operator_for_compound_assignment(operator),
+                expression,
+            )?;
+            self.context
+                .factory()?
+                .set_text_range(expression, original)?;
+            setter_name
+        } else {
+            setter_name
+        };
+        let temp = match value_use {
+            ExpressionValueUse::Required => Some(self.allocate_hoisted_super_temp()?),
+            ExpressionValueUse::Discarded => None,
+        };
+        if let Some(temp) = &temp {
+            let target = self.create_temp_identifier(temp)?;
+            self.context.factory()?.set_text_range(target, original)?;
+            expression = self.create_assignment(target, expression)?;
+        }
+        let super_target = self.create_class_super_reference(class_super)?;
+        let receiver = self.clone_receiver_class_this(class_this)?;
+        expression =
+            self.create_reflect_set_call(super_target, setter_name, expression, receiver)?;
+        self.set_original_and_range(expression, original)?;
+        if let Some(temp) = &temp {
+            let result = self.create_temp_identifier(temp)?;
+            self.context.factory()?.set_text_range(result, original)?;
+            expression = self.create_binary(expression, SyntaxKind::CommaToken, result)?;
+            self.context
+                .factory()?
+                .set_text_range(expression, original)?;
+        }
+        Ok(expression.node())
+    }
+
+    /// tsc-port: visitPreOrPostfixUnaryExpression @6.0.3
+    #[allow(clippy::too_many_arguments)]
+    fn visit_pre_or_postfix_unary_expression(
+        &mut self,
+        original: TransformNode,
+        data: NodeData,
+        operator: SyntaxKind,
+        operand: Option<NodeId>,
+        is_prefix: bool,
+        value_use: ExpressionValueUse,
+    ) -> Result<NodeId, TransformError> {
+        if matches!(
+            operator,
+            SyntaxKind::PlusPlusToken | SyntaxKind::MinusMinusToken
+        ) {
+            if let Some(operand) = operand.map(|operand| self.node(operand)) {
+                let target = self.skip_parenthesized_expression(operand)?;
+                if let Some((class_this, class_super)) = self.super_receiver_pair() {
+                    if self.is_super_property(target)? {
+                        if let Some(setter_name) = self.super_property_key(target)? {
+                            return self.lower_super_update(
+                                original,
+                                operand,
+                                operator,
+                                is_prefix,
+                                value_use,
+                                setter_name,
+                                class_this,
+                                class_super,
+                            );
+                        }
+                    }
+                }
+            }
+        }
+        self.update_generic(original, data)
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    fn lower_super_update(
+        &mut self,
+        original: TransformNode,
+        operand: TransformNode,
+        operator: SyntaxKind,
+        is_prefix: bool,
+        value_use: ExpressionValueUse,
+        setter_name: TransformNode,
+        class_this: TransformNode,
+        class_super: TransformNode,
+    ) -> Result<NodeId, TransformError> {
+        let (getter_name, setter_name) = self.split_super_key_for_read_write(setter_name)?;
+        let super_target = self.create_class_super_reference(class_super)?;
