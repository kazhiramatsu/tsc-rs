+    fn span_end(
+        &self,
+        nodes: &[TransformNode],
+        start: usize,
+        predicate: impl Fn(&Self, TransformNode) -> Result<bool, TransformError>,
+    ) -> Result<usize, TransformError> {
+        let mut index = start;
+        while index < nodes.len() && predicate(self, nodes[index])? {
+            index += 1;
+        }
+        Ok(index)
+    }
