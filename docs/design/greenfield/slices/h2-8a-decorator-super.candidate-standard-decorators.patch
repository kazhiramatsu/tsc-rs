+                let mut data = data;
+                data.left = Some(self.visit_assignment_pattern(left)?.node());
+                data.right = data
+                    .right
+                    .map(|right| self.visit_required(right, SyntaxKind::BinaryExpression, "right"))
+                    .transpose()?
+                    .map(|right| right.node());
+                return self.update_node_data(original, NodeData::BinaryExpression(data));
+            }
+            // isAssignmentExpression(node) &&
+            // isNamedEvaluation(node, isAnonymousClassNeedingAssignedName):
+            // `D = @dec class {}` (also `&&=`, `||=`, `??=`) assigns the
+            // identifier's name; the class is then visited as a child.
+            if matches!(
+                operator,
+                SyntaxKind::EqualsToken
+                    | SyntaxKind::AmpersandAmpersandEqualsToken
+                    | SyntaxKind::BarBarEqualsToken
+                    | SyntaxKind::QuestionQuestionEqualsToken
+            ) && self.identifier_text(left)?.is_some()
+            {
+                if let Some(right) = data.right {
+                    self.record_named_evaluation(right, NamedEvaluationName::Literal(left))?;
+                }
+            }
+            if Self::is_assignment_operator(operator)
+                && self.is_left_hand_side_expression(left)?
+                && self.is_super_property(left)?
+            {
+                if let Some((class_this, class_super)) = self.super_receiver_pair() {
+                    if let Some(setter_name) = self.super_property_key(left)? {
+                        return self.lower_super_assignment(
+                            original,
+                            left,
+                            data.right,
+                            operator,
+                            value_use,
+                            setter_name,
+                            class_this,
+                            class_super,
+                        );
+                    }
+                }
+            }
+        }
+        if operator == SyntaxKind::CommaToken {
+            let mut data = data;
+            data.left = self.visit_optional_discarded_value(data.left)?;
+            data.right = match value_use {
+                ExpressionValueUse::Discarded => self.visit_optional_discarded_value(data.right)?,
+                ExpressionValueUse::Required => self.visit_optional_node(data.right)?,
+            };
+            return self.update_node_data(original, NodeData::BinaryExpression(data));
+        }
+        self.update_generic(original, NodeData::BinaryExpression(data))
+    }
