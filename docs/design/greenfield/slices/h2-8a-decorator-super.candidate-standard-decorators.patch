+    /// The generic property path: the initializer is visited in its own
+    /// environment, wrapped when declarations were hoisted, and the wrapped
+    /// node is memoized under the original initializer id so the declaration's
+    /// generic child visit picks it up without a second traversal.
+    fn visit_property_initializer_in_environment(
+        &mut self,
+        initializer: Option<NodeId>,
+    ) -> Result<(), TransformError> {
+        let Some(initializer) = initializer else {
+            return Ok(());
+        };
+        self.context.start_lexical_environment()?;
+        let visited = self.visit(initializer);
+        let environment = self.context.end_lexical_environment()?;
+        let Some(visited) = visited? else {
+            return Ok(());
+        };
+        if environment.is_empty() {
+            return Ok(());
+        }
+        let wrapped = self.wrap_initializer_with_environment(self.node(visited), environment)?;
+        self.nodes.insert(initializer, Some(wrapped.node()));
+        Ok(())
+    }
