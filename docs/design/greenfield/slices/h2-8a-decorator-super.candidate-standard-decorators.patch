+    fn wrap_initializer_with_environment(
+        &mut self,
+        initializer: TransformNode,
+        environment: LexicalEnvironment,
+    ) -> Result<TransformNode, TransformError> {
+        if environment.is_empty() {
+            return Ok(initializer);
+        }
+        let mut statements = self.materialize_lexical_environment(environment)?;
+        statements.push(self.create_return_statement(initializer)?);
+        let body = self.create_block(statements, true)?;
+        let arrow = self.create_arrow(Vec::new(), body)?;
+        let arrow = self.create_parenthesized(arrow)?;
+        self.create_call(arrow, Vec::new())
+    }
