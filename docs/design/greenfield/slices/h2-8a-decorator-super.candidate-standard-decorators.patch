+    /// tsc-port: isAssignmentExpression @6.0.3
+    fn is_assignment_expression(
+        &self,
+        node: TransformNode,
+        exclude_compound_assignment: bool,
+    ) -> Result<bool, TransformError> {
+        let NodeData::BinaryExpression(data) = self.context.arena().node(node)?.data.clone() else {
+            return Ok(false);
+        };
+        let (Some(operator), Some(left)) = (data.operator_token, data.left) else {
+            return Ok(false);
+        };
+        let operator = self.context.arena().node(self.node(operator))?.kind;
+        let is_assignment = if exclude_compound_assignment {
+            operator == SyntaxKind::EqualsToken
+        } else {
+            Self::is_assignment_operator(operator)
+        };
+        Ok(is_assignment && self.is_left_hand_side_expression(self.node(left))?)
+    }
