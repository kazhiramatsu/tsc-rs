+    /// The `super` token of a super property access: the original node and
+    /// text range tsc assigns to the `Reflect.get` replacement.
+    fn super_property_receiver(
+        &self,
+        node: TransformNode,
+    ) -> Result<TransformNode, TransformError> {
+        let expression = match &self.context.arena().node(node)?.data {
+            NodeData::PropertyAccessExpression(data) => data.expression,
+            NodeData::ElementAccessExpression(data) => data.expression,
+            _ => None,
+        };
+        expression.map(|expression| self.node(expression)).ok_or(
+            TransformError::RequiredChildRemoved {
+                parent: SyntaxKind::PropertyAccessExpression,
+                field: "super receiver",
+            },
+        )
+    }
