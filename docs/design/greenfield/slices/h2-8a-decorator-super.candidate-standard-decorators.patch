+                let expression =
+                    self.visit_required(callee.node(), SyntaxKind::CallExpression, "expression")?;
+                let arguments = self.visit_optional_nodes(data.arguments)?;
+                let mut call_arguments = vec![self.clone_receiver_class_this(class_this)?];
+                call_arguments.extend(self.array_nodes(arguments)?);
+                let call = self.create_property_access(expression, "call")?;
+                let invocation = self.create_call(call, call_arguments)?;
