+    /// Both receiver identities of the current frame (`classThis && classSuper`).
+    const fn super_receiver_pair(&self) -> Option<(TransformNode, TransformNode)> {
+        match (self.receiver_class_this, self.receiver_class_super) {
+            (Some(class_this), Some(class_super)) => Some((class_this, class_super)),
+            _ => None,
+        }
+    }
