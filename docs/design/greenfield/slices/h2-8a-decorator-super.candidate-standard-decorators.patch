+        });
+        Ok(Some(self.update_node_data(block, NodeData::Block(data))?))
+    }
+
+    /// tsc-port: visitClassStaticBlockDeclaration (visitEachChild branch) +
+    /// visitEachChildOfClassStaticBlockDeclaration @6.0.3
+    fn visit_class_static_block_declaration(
+        &mut self,
+        original: TransformNode,
+        mut data: tsc_syntax::nodes::ClassStaticBlockDeclarationData,
+    ) -> Result<NodeId, TransformError> {
+        data.modifiers = self.visit_optional_nodes(data.modifiers)?;
+        self.context.start_lexical_environment()?;
+        data.body = self.visit_function_body(data.body)?;
+        self.update_node_data(original, NodeData::ClassStaticBlockDeclaration(data))
+    }
+
+    /// tsc-port: visitEachChildOfArrowFunction + visitParameterList @6.0.3 —
+    /// the arrow's environment starts active (InParameters) while the
+    /// parameters are visited, so a function or class nested in a parameter
+    /// default starts its own environment normally; it is then suspended
+    /// until visitFunctionBody resumes it and merges the hoisted declarations.
+    fn visit_arrow_function(
+        &mut self,
+        original: TransformNode,
+        mut data: tsc_syntax::nodes::ArrowFunctionData,
+    ) -> Result<NodeId, TransformError> {
+        data.modifiers = self.visit_optional_nodes(data.modifiers)?;
+        data.type_parameters = self.visit_optional_nodes(data.type_parameters)?;
+        self.context.start_lexical_environment()?;
+        self.context
+            .set_lexical_environment_flags(LexicalEnvironmentFlags::IN_PARAMETERS, true)?;
+        let parameters = self.visit_optional_nodes(data.parameters);
+        // visitParameterList: a temp hoisted while visiting the parameters
+        // (a super update / compound assignment in a default) cannot live in
+        // the parameter scope, so the defaults move into the body.
+        let parameters = match parameters {
+            Ok(parameters)
+                if self
+                    .context
+                    .lexical_environment_flags()
+                    .contains(LexicalEnvironmentFlags::VARIABLES_HOISTED_IN_PARAMETERS)
+                    && self.target >= ScriptTarget::ES2015 =>
+            {
+                self.lower_arrow_parameter_defaults(parameters)
+            }
+            other => other,
+        };
+        self.context
+            .set_lexical_environment_flags(LexicalEnvironmentFlags::IN_PARAMETERS, false)?;
+        data.parameters = parameters?;
+        self.context.suspend_lexical_environment()?;
+        data.r#type = self.visit_optional_node(data.r#type)?;
+        data.equals_greater_than_token =
+            self.visit_optional_node(data.equals_greater_than_token)?;
+        self.context.resume_lexical_environment()?;
+        data.body = self.visit_function_body(data.body)?;
+        self.update_node_data(original, NodeData::ArrowFunction(data))
+    }
+
+    /// tsc-port: visitParameterDeclaration @6.0.3 (_tsc.js:100202-100225) —
+    /// modifiers (an erased parameter decorator still reaches this visitor),
+    /// question token and type are dropped; when the parameter changed, it
+    /// takes the original's comment range, the text and source-map ranges
+    /// past its modifiers (`moveRangePastModifiers`), and its name loses its
+    /// trailing source map (`(a = super.x) => a` maps the default, not the
+    /// end of `a`). The named-evaluation arm (an anonymous decorated class
+    /// as the default) has no owner here and is not exercised by the
+    /// witnesses.
+    fn visit_parameter_declaration(
+        &mut self,
+        original: TransformNode,
+        mut data: tsc_syntax::nodes::ParameterData,
+    ) -> Result<NodeId, TransformError> {
+        let last_modifier = self.array_nodes(data.modifiers)?.last().copied();
+        data.modifiers = None;
+        // isNamedEvaluation(node, isAnonymousClassNeedingAssignedName) →
+        // transformNamedEvaluation: an identifier parameter's anonymous
+        // decorated class default receives the parameter's name.
+        if data.dot_dot_dot_token.is_none() {
+            if let (Some(name), Some(initializer)) = (data.name, data.initializer) {
+                if self.identifier_text(self.node(name))?.is_some() {
+                    self.record_named_evaluation(
+                        initializer,
+                        NamedEvaluationName::Literal(self.node(name)),
+                    )?;
+                }
+            }
+        }
+        data.name = self.visit_optional_node(data.name)?;
+        data.question_token = None;
+        data.r#type = None;
+        data.initializer = self.visit_optional_node(data.initializer)?;
+        let name = data.name;
+        let updated = self.update_node_data(original, NodeData::Parameter(data))?;
+        if updated != original.node() {
+            let updated_node = self.node(updated);
+            let record = self.context.arena().node(original)?;
+            let (pos, end) = (record.pos, record.end);
+            // moveRangePastModifiers: the range starts after the last modifier.
+            let past_modifiers_pos = match last_modifier {
+                Some(modifier) => self.context.arena().node(modifier)?.end,
+                None => pos,
+            };
+            let source = self.context.arena().source(original.source())?.syntax();
+            let comment_range =
+                SourceRange::from_raw(pos, end, source.positions()).map_err(|error| {
+                    TransformError::InvalidSourceRange {
+                        node: original,
+                        error,
+                    }
+                })?;
+            let past_modifiers = SourceRange::from_raw(past_modifiers_pos, end, source.positions())
+                .map_err(|error| TransformError::InvalidSourceRange {
+                    node: original,
+                    error,
+                })?;
+            self.context
+                .arena_mut()?
+                .metadata_mut(updated_node)
+                .set_comment_range(crate::CommentRange::new(original.source(), comment_range));
+            self.context.factory()?.set_text_range_from_source_range(
+                updated_node,
+                original.source(),
+                past_modifiers,
+            )?;
+            self.context
+                .arena_mut()?
+                .metadata_mut(updated_node)
+                .set_source_map_range(SourceMapRange::new(original.source(), past_modifiers));
+            if let Some(name) = name {
+                let name = self.node(name);
+                self.context
+                    .arena_mut()?
+                    .metadata_mut(name)
+                    .add_flags(EmitFlags::NO_TRAILING_SOURCE_MAP);
+            }
+        }
+        Ok(updated)
+    }
+
+    /// tsc-port: addDefaultValueAssignmentsIfNeeded @6.0.3
+    /// (_tsc.js:91182-91262), reached from visitParameterList when
+    /// `VariablesHoistedInParameters` is set and the target is >= ES2015 (the
+    /// ES2015 transform owns the ES5 form). Every parameter of the list is
+    /// rewritten once: a rest parameter is kept, a binding pattern becomes a
+    /// generated parameter plus `var pattern = _a === void 0 ? init : _a;`,
+    /// an initializer becomes `if (p === void 0) { p = init; }`; both join
+    /// the arrow's environment as initialization statements that
+    /// visitFunctionBody merges after the hoisted `var`s.
+    fn lower_arrow_parameter_defaults(
+        &mut self,
+        parameters: Option<NodeArrayId>,
+    ) -> Result<Option<NodeArrayId>, TransformError> {
+        let Some(parameters) = parameters else {
+            return Ok(None);
+        };
+        let original = self.array(parameters);
+        let nodes = self.context.arena().node_array(original)?.nodes.clone();
+        let mut lowered = Vec::with_capacity(nodes.len());
+        for parameter in nodes {
+            lowered.push(self.lower_arrow_parameter_default(self.node(parameter))?);
+        }
+        Ok(Some(
+            self.context
+                .factory()?
+                .update_node_array(original, lowered)?
+                .array(),
+        ))
+    }
+
+    /// tsc-port: addDefaultValueAssignmentIfNeeded +
+    /// addDefaultValueAssignmentForBindingPattern +
+    /// addDefaultValueAssignmentForInitializer @6.0.3
+    fn lower_arrow_parameter_default(
+        &mut self,
+        original: TransformNode,
+    ) -> Result<TransformNode, TransformError> {
+        let NodeData::Parameter(mut data) = self.context.arena().node(original)?.data.clone()
+        else {
+            return Ok(original);
+        };
+        if data.dot_dot_dot_token.is_some() {
+            return Ok(original);
+        }
+        let name =
+            data.name
+                .map(|id| self.node(id))
+                .ok_or(TransformError::RequiredChildRemoved {
+                    parent: SyntaxKind::Parameter,
+                    field: "name",
+                })?;
+        if matches!(
+            self.context.arena().node(name)?.kind,
+            SyntaxKind::ObjectBindingPattern | SyntaxKind::ArrayBindingPattern
+        ) {
+            // getGeneratedNameForNode(parameter): an ordinary auto temp shared
+            // by the parameter and both reads of the initialization statement.
+            let binding = self.allocate_super_temp()?;
+            let value = if let Some(initializer) = data.initializer.map(|id| self.node(id)) {
+                let condition_name = self.create_temp_identifier(&binding)?;
+                let undefined = self.create_void_zero()?;
+                let condition = self.create_binary(
+                    condition_name,
+                    SyntaxKind::EqualsEqualsEqualsToken,
+                    undefined,
+                )?;
+                let fallback = self.create_temp_identifier(&binding)?;
+                self.create_conditional(condition, initializer, fallback)?
+            } else {
+                self.create_temp_identifier(&binding)?
+            };
+            let declaration = self.create_variable_declaration_with_name(name, Some(value))?;
+            let statement = self
+                .create_variable_statement_from_declarations(vec![declaration], NodeFlags::NONE)?;
+            self.context.add_initialization_statement(statement)?;
+            data.name = Some(self.create_temp_identifier(&binding)?.node());
+            data.initializer = None;
+        } else if let Some(initializer) = data.initializer.map(|id| self.node(id)) {
+            let condition_name = self.context.factory()?.clone_node(name)?;
+            let undefined = self.create_void_zero()?;
+            let condition = self.create_binary(
+                condition_name,
+                SyntaxKind::EqualsEqualsEqualsToken,
+                undefined,
+            )?;
+            let assignment_name = self.context.factory()?.clone_node(name)?;
+            self.context
+                .arena_mut()?
+                .metadata_mut(assignment_name)
+                .set_flags(EmitFlags::NO_SOURCE_MAP);
+            self.context
+                .arena_mut()?
+                .metadata_mut(initializer)
+                .add_flags(EmitFlags::NO_SOURCE_MAP | EmitFlags::NO_COMMENTS);
+            let assignment = self.create_assignment(assignment_name, initializer)?;
+            self.context
+                .factory()?
+                .set_text_range(assignment, original)?;
+            self.context
+                .arena_mut()?
+                .metadata_mut(assignment)
+                .set_flags(EmitFlags::NO_COMMENTS);
+            let statement = self.create_expression_statement(assignment)?;
+            let block = self.create_block(vec![statement], false)?;
+            self.context.factory()?.set_text_range(block, original)?;
+            self.context.arena_mut()?.metadata_mut(block).set_flags(
+                EmitFlags::SINGLE_LINE
+                    | EmitFlags::NO_TRAILING_SOURCE_MAP
+                    | EmitFlags::NO_TOKEN_SOURCE_MAPS
+                    | EmitFlags::NO_COMMENTS,
+            );
+            let statement = self.context.factory()?.create_node(
+                self.source,
+                NodeData::IfStatement(tsc_syntax::nodes::IfStatementData {
+                    expression: Some(condition.node()),
+                    then_statement: Some(block.node()),
+                    else_statement: None,
+                }),
+                TransformFlags::NONE,
+            )?;
+            self.context.add_initialization_statement(statement)?;
+            data.initializer = None;
+        } else {
+            return Ok(original);
+        }
+        let updated = self.update_node_data(original, NodeData::Parameter(data))?;
+        Ok(self.node(updated))
+    }
+}
+
+impl StandardDecoratorVisitor<'_> {
+    /// The computed property name of a property, method or accessor member.
+    fn member_computed_name(
+        &self,
+        member: TransformNode,
+    ) -> Result<Option<TransformNode>, TransformError> {
+        let name = match &self.context.arena().node(member)?.data {
+            NodeData::PropertyDeclaration(data) => data.name,
+            NodeData::MethodDeclaration(data) => data.name,
+            NodeData::GetAccessor(data) => data.name,
+            NodeData::SetAccessor(data) => data.name,
+            _ => None,
+        };
+        let Some(name) = name.map(|name| self.node(name)) else {
+            return Ok(None);
+        };
+        Ok(matches!(
+            self.context.arena().node(name)?.data,
+            NodeData::ComputedPropertyName(_)
+        )
+        .then_some(name))
+    }
+
+    /// tsc-port: visitComputedPropertyName @6.0.3 (undecorated member) — the
+    /// key expression is visited under the name frame; when it is not simply
+    /// inlineable, the pending expressions are injected ahead of it and the
+    /// updated name is memoized for the member's later visit.
+    fn inject_pending_into_undecorated_computed_name(
+        &mut self,
+        member: TransformNode,
+        pending: &mut Vec<TransformNode>,
+        class_fields_boundary: usize,
+    ) -> Result<bool, TransformError> {
+        let Some(name) = self.member_computed_name(member)? else {
+            return Ok(false);
+        };
+        let NodeData::ComputedPropertyName(mut data) =
+            self.context.arena().node(name)?.data.clone()
+        else {
+            return Ok(false);
+        };
+        let Some(expression) = data.expression else {
+            return Ok(false);
+        };
+        self.enter_receiver_name();
+        let visited = self.visit(expression);
+        self.exit_receiver_name();
+        let visited = visited?.map(|expression| self.node(expression)).ok_or(
+            TransformError::RequiredChildRemoved {
+                parent: SyntaxKind::ComputedPropertyName,
+                field: "expression",
+            },
+        )?;
+        if pending.is_empty() || self.is_simple_inlineable_expression(visited)? {
+            return Ok(false);
+        }
+        // esDecorators injects its pending entries (after the boundary) into
+        // this name; class-field lowering then injects the boundary entries (a
+        // preceding decorated field's key evaluation) ahead of the sequence.
+        let own = pending.split_off(class_fields_boundary);
+        let mut injected = self.inject_pending_expressions(own, visited)?;
+        if !pending.is_empty() {
+            let outer = std::mem::take(pending);
+            injected = self.inject_pending_expressions(outer, injected)?;
+        }
+        data.expression = Some(injected.node());
+        let updated = self.update_node_data(name, NodeData::ComputedPropertyName(data))?;
+        self.nodes.insert(name.node(), Some(updated));
+        Ok(true)
+    }
+
+    /// tsc-port: injectPendingExpressionsCommon @6.0.3
+    fn inject_pending_expressions(
+        &mut self,
+        mut pending: Vec<TransformNode>,
+        expression: TransformNode,
+    ) -> Result<TransformNode, TransformError> {
+        if let NodeData::ParenthesizedExpression(mut data) =
+            self.context.arena().node(expression)?.data.clone()
+        {
+            let inner = data.expression.map(|inner| self.node(inner)).ok_or(
+                TransformError::RequiredChildRemoved {
+                    parent: SyntaxKind::ParenthesizedExpression,
+                    field: "expression",
+                },
+            )?;
+            pending.push(inner);
+            let inlined = self.inline_expressions(pending)?;
+            data.expression = Some(inlined.node());
+            let updated =
+                self.update_node_data(expression, NodeData::ParenthesizedExpression(data))?;
+            return Ok(self.node(updated));
+        }
+        pending.push(expression);
+        self.inline_expressions(pending)
+    }
+}
+
+impl StandardDecoratorVisitor<'_> {
+    /// tsc-port: skipOuterExpressions (kinds All) @6.0.3
+    fn skip_outer_expressions(
+        &self,
+        mut node: TransformNode,
+    ) -> Result<TransformNode, TransformError> {
+        loop {
+            let inner = match &self.context.arena().node(node)?.data {
+                NodeData::ParenthesizedExpression(data) => data.expression,
+                NodeData::TypeAssertionExpression(data) => data.expression,
+                NodeData::AsExpression(data) => data.expression,
+                NodeData::SatisfiesExpression(data) => data.expression,
+                NodeData::NonNullExpression(data) => data.expression,
+                NodeData::ExpressionWithTypeArguments(data) => data.expression,
+                NodeData::PartiallyEmittedExpression(data) => data.expression,
+                _ => return Ok(node),
+            };
+            node = inner.map(|inner| self.node(inner)).ok_or(
+                TransformError::RequiredChildRemoved {
+                    parent: SyntaxKind::ParenthesizedExpression,
+                    field: "outer expression",
+                },
+            )?;
+        }
+    }
+
+    /// tsc-port: transformClassLike `safeExtendsExpression` @6.0.3
+    fn safe_extends_expression(
+        &mut self,
+        extends_expression: TransformNode,
+    ) -> Result<TransformNode, TransformError> {
+        let unwrapped = self.skip_outer_expressions(extends_expression)?;
+        let anonymous = match &self.context.arena().node(unwrapped)?.data {
+            NodeData::ClassExpression(data) => data.name.is_none(),
+            NodeData::FunctionExpression(data) => data.name.is_none(),
+            NodeData::ArrowFunction(_) => true,
+            _ => false,
+        };
+        if !anonymous {
+            return Ok(extends_expression);
+        }
+        let zero = self.create_numeric_literal("0")?;
+        self.create_binary(zero, SyntaxKind::CommaToken, extends_expression)
+    }
+}
