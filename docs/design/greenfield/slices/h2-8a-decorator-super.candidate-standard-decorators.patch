+    /// tsc-port: endLexicalEnvironment (statement materialization) @6.0.3
+    fn materialize_lexical_environment(
+        &mut self,
+        environment: LexicalEnvironment,
+    ) -> Result<Vec<TransformNode>, TransformError> {
+        let mut statements = environment.function_declarations().to_vec();
+        if !environment.variable_declarations().is_empty() {
+            let statement = self.create_variable_statement_from_declarations(
+                environment.variable_declarations().to_vec(),
+                NodeFlags::NONE,
+            )?;
