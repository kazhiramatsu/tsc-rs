+        &self,
+        _node: EmitResolverNode,
+        _mode: EmitExportContainerMode,
+    ) -> Result<Option<EmitResolverNode>, EmitResolverError> {
+        Ok(None)
+    }
+
+    fn has_node_check_flag(
+        &self,
