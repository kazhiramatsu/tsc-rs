+function observeLifecycle(row) {
+  const sourceFile = ts.createSourceFile("main.ts", LIFECYCLE_SOURCE, ts.ScriptTarget.ESNext, true);
+  if (row.op === "reprint" || row.op === "clone" || row.op === "dispose") {
