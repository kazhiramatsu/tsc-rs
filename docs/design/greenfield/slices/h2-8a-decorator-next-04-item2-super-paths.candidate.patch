+            NodeData::SpreadElement(data) => self.visit_assignment_rest_element(node, data),
+            NodeData::OmittedExpression(_) => self.visit_required(
+                Some(node.node()),
+                SyntaxKind::ArrayLiteralExpression,
+                "element",
+            ),
+            _ => self.visit_assignment_element(node),
+        }
+    }
