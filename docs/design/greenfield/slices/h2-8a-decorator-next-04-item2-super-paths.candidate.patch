+    /// tsc-port: visitCommaListExpression @6.0.3
+    fn visit_comma_list_expression(
+        &mut self,
+        original: TransformNode,
+        mut data: tsc_syntax::nodes::CommaListExpressionData,
+        value_use: DecoratorValueUse,
