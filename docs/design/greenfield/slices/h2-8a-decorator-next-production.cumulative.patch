+    /// tsc-port: visitAssignmentElement @6.0.3
+    fn visit_assignment_element(
+        &mut self,
+        node: TransformNode,
+    ) -> Result<TransformNode, TransformError> {
+        if let NodeData::BinaryExpression(mut data) = self.context.arena().node(node)?.data.clone()
